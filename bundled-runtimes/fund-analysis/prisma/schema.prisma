// ============================================================
// 新增：业绩归因（Brinson模型）
// ============================================================
model PerformanceAttribution {
  id          String @id @default(uuid())
  fundId      String @map("fund_id")
  benchmarkId String @map("benchmark_id") // 基准指数，如 "000300" 沪深300
  quarter     String

  // 收益数据
  totalReturn     Decimal @map("total_return") @db.Decimal(10, 4)
  benchmarkReturn Decimal @map("benchmark_return") @db.Decimal(10, 4)
  activeReturn    Decimal @map("active_return") @db.Decimal(10, 4)

  // Brinson 归因分解
  allocationEffect  Decimal? @map("allocation_effect") @db.Decimal(10, 4) // 资产配置效应
  selectionEffect   Decimal? @map("selection_effect") @db.Decimal(10, 4) // 个股选择效应
  interactionEffect Decimal? @map("interaction_effect") @db.Decimal(10, 4) // 交互效应

  // 简化归因（十大重仓股）
  industryAllocation Decimal? @map("industry_allocation") @db.Decimal(10, 4) // 行业配置贡献
  stockSelection     Decimal? @map("stock_selection") @db.Decimal(10, 4) // 个股选择贡献
  residual           Decimal? @map("residual") @db.Decimal(10, 4) // 残差/非重仓股贡献

  createdAt DateTime @default(now()) @map("created_at")

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, quarter])
  @@index([fundId, quarter])
  @@map("performance_attributions")
}

// ============================================================
// 新增：基金经理画像
// ============================================================
model ManagerProfile {
  id          String   @id @default(uuid())
  managerId   String   @unique @map("manager_id")
  lastUpdated DateTime @default(now()) @map("last_updated")

  // 投资框架（从已确认纪要提取）
  productPositioning  String? @map("product_positioning") @db.Text
  investmentObjective String? @map("investment_objective") @db.Text
  investmentMethod    String? @map("investment_method") @db.Text

  // 投资理念（从专访提取）
  corePhilosophy      String? @map("core_philosophy") @db.Text
  stockSelectionLogic String? @map("stock_selection_logic") @db.Text
  riskPhilosophy      String? @map("risk_philosophy")

  // 能力圈
  focusIndustries      String[] @map("focus_industries")
  competenceAdvantages String?  @map("competence_advantages") @db.Text
  competenceBoundaries String?  @map("competence_boundaries") @db.Text

  // 投资风格
  styleLabel         String? @map("style_label") // 价值/成长/平衡/激进
  concentration      String? @db.Text
  turnover           String? @db.Text
  excessReturnSource String? @map("excess_return_source") @db.Text
  holdingStyle       String? @map("holding_style") @db.Text
  styleStability     Int?    @map("style_stability") // 风格稳定性评分 0-100

  // 评分
  philosophyScore     Int? @map("philosophy_score") // 理念评分 0-100
  competenceScore     Int? @map("competence_score") // 能力圈评分 0-100
  styleScore          Int? @map("style_score") // 风格评分 0-100
  overallQualityScore Int? @map("overall_quality_score") // 综合素质评分 0-100

  // 一致性分析
  philosophyBehaviorConsistency Decimal? @map("philosophy_behavior_consistency") @db.Decimal(5, 2) // 理念-行为一致性 0-100
  valuationConsistency          Int?     @map("valuation_consistency") // 估值一致性 0-100
  qualityConsistency            Int?     @map("quality_consistency") // 质量一致性 0-100
  industryConsistency           Int?     @map("industry_consistency") // 行业一致性 0-100

  // 关键洞察和风险警示
  keyInsights String[] @map("key_insights")
  redFlags    String[] @map("red_flags")

  // 元数据
  interviewsAnalyzed Int       @default(0) @map("interviews_analyzed")
  lastInterviewDate  DateTime? @map("last_interview_date")
  evidence           Json      @default("{}")
  updatedBy          String?   @map("updated_by")

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@map("manager_profiles")
}

// ============================================================
// 新增：投资理念追踪（季度）
// ============================================================
model PhilosophyTracking {
  id                String  @id @default(uuid())
  managerId         String  @map("manager_id")
  quarter           String
  philosophySummary String  @map("philosophy_summary")
  consistencyScore  Decimal @map("consistency_score") @db.Decimal(5, 2) // 与历史一致性 0-100

  // 风格指标
  styleLabel String? @map("style_label")
  peFocus    String? @map("pe_focus") // 估值偏好
  roeFocus   String? @map("roe_focus") // 质量偏好

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([managerId, quarter])
  @@index([managerId])
  @@map("philosophy_tracking")
}

// ============================================================
// 新增：因子收益率（因子库）
// ============================================================
model FactorReturn {
  id         String  @id @default(uuid())
  factorName String  @map("factor_name")
  date       String // 月份 "2024-01"
  return     Decimal @db.Decimal(10, 4)

  @@unique([factorName, date])
  @@index([factorName])
  @@map("factor_returns")
}

// ============================================================
// 新增：行业收益率
// ============================================================
model IndustryReturn {
  id           String  @id @default(uuid())
  industry     String
  benchmarkId  String  @map("benchmark_id")
  quarter      String
  fundReturn   Decimal @map("fund_return") @db.Decimal(10, 4)
  benchReturn  Decimal @map("bench_return") @db.Decimal(10, 4)
  activeReturn Decimal @map("active_return") @db.Decimal(10, 4)

  @@unique([industry, benchmarkId, quarter])
  @@index([industry])
  @@map("industry_returns")
}

// ============================================================
// 投资论点结构化 (Investment Thesis) — 研究结论的容器
// 每只重点研究基金能保存一份结构化论点：为什么买、卖出触发、有效期、
// 支撑证据快照 ID、状态机与编辑历史，用于后续复盘和学习。
// ============================================================
enum InvestmentThesisState {
  candidate
  researching
  observing
  invalid
  archived
}

model InvestmentThesis {
  id           String                @id @default(uuid()) @db.Uuid
  fundWindCode String                @map("fund_wind_code")
  title        String
  state        InvestmentThesisState @default(candidate)

  coreReasoning Json    @default("[]") @map("core_reasoning")
  sellTriggers  Json    @default("[]") @map("sell_triggers")
  oneLiner      String? @map("one_liner")
  counterView   String? @map("counter_view")
  risks         Json    @default("[]")

  validUntil        DateTime? @map("valid_until") @db.Date
  nextReviewDate    DateTime? @map("next_review_date") @db.Date
  reviewCadenceDays Int       @default(30) @map("review_cadence_days")

  evidenceSnapshot Json @default("{}") @map("evidence_snapshot")

  stateHistory Json @default("[]") @map("state_history")
  editHistory  Json @default("[]") @map("edit_history")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  closedAt  DateTime? @map("closed_at") @db.Timestamptz

  closeReason  String? @map("close_reason")
  closeVerdict String? @map("close_verdict")

  queueItems ResearchQueueItem[]
  postmortems DecisionPostmortem[]

  @@index([fundWindCode])
  @@index([state])
  @@index([nextReviewDate])
  @@map("investment_theses")
}

// ============================================================
// 观察项 (Fund Watches) — 任意基金+任意指标+阈值+夜扫
// ============================================================
enum WatchStatus {
  active
  triggered
  dismissed
}

model FundWatch {
  id             String      @id @default(uuid()) @db.Uuid
  fundWindCode   String      @map("fund_wind_code")
  metricField    String      @map("metric_field")
  operator       String      @default(">=")
  threshold      Float
  note           String?
  status         WatchStatus @default(active)
  triggeredAt    DateTime?   @map("triggered_at") @db.Timestamptz
  triggeredValue Float?      @map("triggered_value")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@index([fundWindCode])
  @@index([status])
  @@map("fund_watches")
}

// ============================================================
// 研究队列 (Research Queue) — 候选→研究→产出的工作流容器
// ============================================================
enum ResearchQueueStatus {
  queued
  researching
  concluded
  dropped
}

model ResearchQueueItem {
  id              String              @id @default(uuid()) @db.Uuid
  fundWindCode    String              @map("fund_wind_code")
  status          ResearchQueueStatus @default(queued)
  priority        Int                 @default(3)
  source          String?
  sourceRef       String?             @map("source_ref")
  nextReviewDate  DateTime?           @map("next_review_date") @db.Date
  outputCommitted Boolean             @default(false) @map("output_committed")
  thesisId        String?             @map("thesis_id") @db.Uuid
  conclusion      String?
  concludedAt     DateTime?           @map("concluded_at") @db.Timestamptz
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  thesis InvestmentThesis? @relation(fields: [thesisId], references: [id])

  @@index([status])
  @@index([fundWindCode])
  @@index([nextReviewDate])
  @@map("research_queue_items")
}

// ============================================================
// 决策复盘 (Decision Post-mortems) — 论点关闭后强制复盘
// ============================================================
model DecisionPostmortem {
  id                     String   @id @default(uuid()) @db.Uuid
  thesisId               String   @map("thesis_id") @db.Uuid
  fundWindCode           String   @map("fund_wind_code")
  outcome                String
  actualReturnPct        Float?   @map("actual_return_pct")
  peerMedianReturnPct    Float?   @map("peer_median_return_pct")
  excessReturnPct        Float?   @map("excess_return_pct")
  reasoningVerdicts      Json     @default("[]") @map("reasoning_verdicts")
  triggerFired           Boolean  @default(false) @map("trigger_fired")
  triggerDetail          String?  @map("trigger_detail")
  lessonLearned          String?  @map("lesson_learned")
  decisionBias           String?  @map("decision_bias")
  wouldRepeat            Boolean? @map("would_repeat")
  reviewedAt             DateTime @default(now()) @map("reviewed_at") @db.Timestamptz
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  thesis InvestmentThesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)

  @@index([thesisId])
  @@index([fundWindCode])
  @@index([outcome])
  @@map("decision_postmortems")
}

// ============================================================
// 基金组合构建 (Portfolio Construction) — 研究型组合：目标配置、候选准入、等权/自定义权重
// ============================================================
enum PortfolioStatus {
  draft
  active
  archived
}

enum PortfolioWeightSource {
  equal
  custom
}

model Portfolio {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  objective String?
  status    PortfolioStatus @default(draft)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  targets   PortfolioTarget[]
  holdings  PortfolioHolding[]
  snapshots PortfolioSnapshot[]

  @@map("portfolios")
}

model PortfolioTarget {
  id            String   @id @default(uuid()) @db.Uuid
  portfolioId   String   @map("portfolio_id") @db.Uuid
  peerGroupKey  String   @map("peer_group_key")
  peerGroupName String?  @map("peer_group_name")
  targetWeight  Decimal  @map("target_weight") @db.Decimal(8, 6)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("portfolio_targets")
}

model PortfolioHolding {
  id           String                @id @default(uuid()) @db.Uuid
  portfolioId  String                @map("portfolio_id") @db.Uuid
  windCode     String                @map("wind_code")
  weight       Decimal?              @db.Decimal(8, 6)
  weightSource PortfolioWeightSource? @map("weight_source")
  note         String?
  addedAt      DateTime              @default(now()) @map("added_at") @db.Timestamptz
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, windCode])
  @@index([portfolioId])
  @@index([windCode])
  @@map("portfolio_holdings")
}

model PortfolioSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  portfolioId       String   @map("portfolio_id") @db.Uuid
  snapshotDate      DateTime @map("snapshot_date") @db.Date
  holdingCount      Int      @map("holding_count")
  totalWeight       Decimal  @map("total_weight") @db.Decimal(8, 6)
  styleAggregate    Json     @default("{}") @map("style_aggregate")
  overlapMatrix     Json     @default("{}") @map("overlap_matrix")
  correlationMatrix Json     @default("{}") @map("correlation_matrix")
  coverage          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([snapshotDate])
  @@map("portfolio_snapshots")
}
