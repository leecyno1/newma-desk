{
  "name": "fund-analysis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint",
    "doctor": "bash scripts/doctor.sh",
    "smoke:fund-research": "node scripts/fund_research_acceptance_smoke.mjs",
    "smoke:fund-browser": "node scripts/fund_browser_peer_group_smoke.mjs",
    "smoke:fund-compare": "node scripts/fund_comparison_smoke.mjs",
    "smoke:fund-product-detail": "node scripts/fund_product_detail_smoke.mjs",
    "smoke:fund-market-environment": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fund_market_environment_smoke.mjs",
    "smoke:fund-manager-detail": "node scripts/fund_manager_detail_smoke.mjs",
    "smoke:fund-manager-browser": "node scripts/fund_manager_browser_smoke.mjs",
    "smoke:fund-manager-comparison": "node scripts/fund_manager_comparison_smoke.mjs",
    "smoke:fund-home": "node scripts/fund_home_smoke.mjs",
    "smoke:fund-companies": "node scripts/fund_company_browser_smoke.mjs",
    "smoke:watchlist": "node scripts/watchlist_smoke.mjs",
    "smoke:fund-recommendations": "node scripts/fund_recommendation_flow_smoke.mjs",
    "smoke:holding-style-peer": "node scripts/holding_style_peer_evidence_smoke.mjs",
    "smoke:analysis-evidence-metadata": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/analysis_evidence_metadata_smoke.mjs",
    "desk:check": "node scripts/newma_desk_fund_research_compat_smoke.mjs",
    "research:real-data-report": "node scripts/fund_research_real_data_report.mjs",
    "research:sync-ima": "bash scripts/sync_ima_research_library.sh",
    "research:sync-manager-identities": "python backend/scripts/sync_research_memo_manager_identities.py",
    "research:preview-memo-labels": "python backend/scripts/backfill_research_memo_labels.py",
    "research:apply-memo-labels": "python backend/scripts/backfill_research_memo_labels.py --apply",
    "research:preview-viewpoint-topics": "python backend/scripts/backfill_research_memo_viewpoint_topics.py",
    "research:apply-viewpoint-topics": "python backend/scripts/backfill_research_memo_viewpoint_topics.py --apply",
    "data:sync-holding-style": "python backend/scripts/sync_holding_style_snapshots.py",
    "data:sync-hsi": "python backend/scripts/sync_hang_seng_index_snapshot.py",
    "data:sync-holding-research": "python backend/scripts/sync_fund_holdings.py",
    "funds:update-universe": "bash scripts/update_fund_universe.sh",
    "funds:update-ranking-metrics": "bash scripts/update_fund_ranking_metrics.sh",
    "funds:backfill-browser-core": "bash scripts/update_fund_ranking_metrics.sh --browser-core-coverage --limit 100 --days 1120",
    "funds:sync-manager-tenure": "python backend/scripts/sync_fund_manager_tenure.py",
    "funds:sync-manager-universe": "python backend/scripts/sync_fund_manager_universe.py",
    "funds:sync-holdings": "python backend/scripts/sync_fund_holdings.py",
    "funds:sync-product-profiles": "python backend/scripts/sync_fund_product_profiles.py",
    "funds:sync-bond-holdings": "python backend/scripts/sync_fund_bond_holdings.py",
    "funds:backfill-peer-evaluation": "bash scripts/update_fund_ranking_metrics.sh --peer-evaluation-coverage",
    "funds:preview-classification": "bash scripts/update_fund_classification.sh",
    "funds:sync-classification": "bash scripts/update_fund_classification.sh --apply"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@prisma/client": "^7.7.0",
    "@tanstack/react-query": "^5.99.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "16.2.4",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
