# Newma Media Studio 环境模板（保留 DASHENG_* 兼容变量）

# 工作区
DASHENG_WORKSPACE=/path/to/newma-media-studio
FINANCE_MOTION_WORKSPACE=/path/to/finance-motion
DASHENG_OUTPUT_ROOT=~/Desktop/自媒体创作

# 视频外部依赖
PALMIER_PRO_ROOT=/path/to/newma-media-studio/vendor/reserved/video/palmier-pro
PALMIER_MCP_URL=http://127.0.0.1:19789/mcp

# Publish 外部起号/运营策略 Skills（不全局安装）
AGENT_SKILLS_LAUNCH_PACK_ROOT=/path/to/newma-media-studio/vendor/reserved/publish/agent-skills-launch-pack

# 飞书
DASHENG_FEISHU_ROOT_URL=https://example.feishu.cn/drive/folder/replace_me
DASHENG_FEISHU_CHAT_ID=oc_replace_me
FEISHU_APP_ID=cli_xxx_replace_me
FEISHU_APP_SECRET=xxx_replace_me

# 数据接口
TUSHARE_TOKEN=replace_me

# 生图 provider（优先级：启航 -> 魔力方舟 -> 向量 -> MiniMax）
QHAIGC_API_BASE=https://api.qhaigc.net/v1
QHAIGC_API_KEY=replace_me
MOLI_API_BASE=https://ai.gitee.com/v1
MOLI_API_KEY=replace_me
VECTOR_IMAGE_API_BASE=https://api.vectorengine.ai/v1/images/generations
VECTOR_IMAGE_API_KEY=replace_me
MINIMAX_API_KEY=replace_me
