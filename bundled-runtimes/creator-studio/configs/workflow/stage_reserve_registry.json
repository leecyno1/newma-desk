  "routing_policy": {
    "ready": "May be selected by the stage router within its declared execution mode.",
    "adapter_ready": "May be selected only through the named Newma compatibility adapter and its quality gates.",
    "cloned_not_promoted": "Visible to the director as a fallback candidate, but cannot become the primary route before its blockers are cleared.",
    "blocked": "Registered for future adaptation only and must not be invoked directly.",
    "methodology_only": "May inform analysis and review, but no upstream source or executable code may be copied or invoked.",
    "license_guard": "Projects without a verified upstream license remain reference-only and are never cloned by reserve synchronization.",
    "provider_guard": "Official GPT/OpenAI, Kimi/Moonshot, Gemini/Google, Seedance/Jimeng/Seedream and MiniMax model credentials are valid optional dependencies. Third-party service keys and additional desktop Apps are excluded from Transwrite routing."
  },
