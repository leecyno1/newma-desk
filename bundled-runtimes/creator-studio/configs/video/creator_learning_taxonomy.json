{
  "schema_version": "dasheng.video_creator_learning_taxonomy.v1",
  "principles": [
    "只把可复用的形式规律写入知识库，不复制原作者脚本、Logo、专属包装或受版权保护的画面。",
    "观察到的视觉现象与推测的实现技术必须分开记录。技术栈只能写为复现建议或候选方案，不能宣称原作者实际使用了某个框架。",
    "镜头数量不是质量目标。优先保护主题完整性、核心证据连续性和观众理解时间。",
    "自动学习结论只能进入候选规则库，未经人工审核不得覆盖已批准的视频 DNA。"
  ],
  "professional_dimensions": {
    "director": [
      "叙事目标",
      "开场钩子",
      "主题段落",
      "核心场景完整性",
      "证据对象",
      "情绪曲线",
      "信息释放顺序",
      "观众认知负荷",
      "章节桥接",
      "收束方式"
    ],
    "design": [
      "视觉系统",
      "色彩层级",
      "字体层级",
      "版式状态",
      "留白",
      "信息密度",
      "视觉锚点",
      "主次关系",
      "品牌外壳",
      "画面安全区"
    ],
    "storyboard": [
      "分镜意图",
      "景别",
      "画面构成",
      "镜头时长",
      "进入条件",
      "退出条件",
      "旁白绑定",
      "素材绑定",
      "重复控制",
      "核心场景保持"
    ],
    "transition": [
      "语义切换",
      "动作匹配",
      "构图匹配",
      "音频桥接",
      "章节转场",
      "证据切换",
      "淡入淡出",
      "遮罩转场",
      "空间转场",
      "禁止装饰性扫描线"
    ],
    "production": [
      "素材类型",
      "真人状态",
      "画中画",
      "全屏证据",
      "动态排版",
      "B-roll 密度",
      "BGM 能量",
      "音效密度",
      "旁白连续性",
      "渲染质检"
    ],
    "chart": [
      "图表类型",
      "数据语义",
      "时间区间",
      "坐标和单位",
      "重点标记",
      "动态揭示顺序",
      "对比基准",
      "证据来源",
      "最短可读时长",
      "避免重复展示原图"
    ],
    "aesthetic": [
      "调性",
      "视觉情绪",
      "克制程度",
      "精致度",
      "可信感",
      "娱乐性",
      "节奏张力",
      "审美优势",
      "不应复制项",
      "适用内容类型"
    ]
  },
  "reproduction_stack": [
    {
      "tool": "hyperframes",
      "best_for": ["强风格标题帧", "连续构图动画", "Logo 收尾", "VFX 文字和数据揭示"],
      "avoid_for": ["长时间复杂数据图表", "需要精确交互的表格"]
    },
    {
      "tool": "html-anything",
      "best_for": ["信息卡片", "文章证据重构", "流程图", "表格", "网页和文档视觉化"],
      "avoid_for": ["仅把静态页面录屏当动画"]
    },
    {
      "tool": "remotion",
      "best_for": ["精确时间轴", "透明背景动画", "真人口播叠加", "动态图表", "可测试组件化镜头"],
      "avoid_for": ["没有分镜参数时临时堆组件"]
    },
    {
      "tool": "gsap",
      "best_for": ["HTML 元素入场退场", "时间线控制", "路径和数字动画", "章节内连续运动"],
      "avoid_for": ["用高频动效掩盖内容不足"]
    },
    {
      "tool": "lottie",
      "best_for": ["图标动效", "装饰性辅助", "轻量循环动画", "透明背景贴纸"],
      "avoid_for": ["承担核心事实和复杂数据表达"]
    },
    {
      "tool": "html-video",
      "best_for": ["HTML 动画录制", "音频和画面合成", "批量渲染", "浏览器动画转视频"],
      "avoid_for": ["直接把静态截图放大缩小"]
    },
    {
      "tool": "ffmpeg",
      "best_for": ["转码", "拼接", "音量标准化", "黑场静音检测", "最终封装"],
      "avoid_for": ["替代导演分镜和视觉设计"]
    }
  ]
}
