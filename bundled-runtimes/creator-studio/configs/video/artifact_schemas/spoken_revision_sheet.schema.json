{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dasheng.video.spoken_revision_sheet.v1",
  "title": "Newma Video Spoken Revision Sheet",
  "type": "object",
  "required": ["schema_version", "created_at", "pending_count", "rows"],
  "properties": {
    "schema_version": {"const": "dasheng.video.spoken_revision_sheet.v1"},
    "created_at": {"type": "string"},
    "pending_count": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_title",
          "scene_id",
          "start_sec",
          "end_sec",
          "action",
          "original_text",
          "replacement_text",
          "reason",
          "approved",
          "applied"
        ],
        "properties": {
          "claim_id": {"type": "string"},
          "claim_title": {"type": "string"},
          "scene_id": {"type": "string"},
          "start_sec": {"type": ["number", "null"], "minimum": 0},
          "end_sec": {"type": ["number", "null"], "minimum": 0},
          "action": {
            "type": "string",
            "enum": ["replace", "overdub", "rerecord", "remove", "cut", "exclude", "disclose"]
          },
          "original_text": {"type": "string"},
          "replacement_text": {"type": "string"},
          "reason": {"type": "string"},
          "approved": {"type": "boolean"},
          "applied": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
