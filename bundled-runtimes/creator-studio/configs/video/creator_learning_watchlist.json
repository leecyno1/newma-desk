    "timezone": "Asia/Shanghai",
    "hour": 22,
    "minute": 0
  },
  "discovery": {
    "yt_dlp": "yt-dlp",
    "cookies_from_browser": "chrome",
    "impersonate": "Chrome-136:Macos-15",
    "playlist_items": 3,
    "max_new_per_creator": 2,
    "bootstrap_mode": "baseline_only",
    "video_format": "bv*[height<=720]+ba/b[height<=720]",
    "max_filesize_mb": 1500,
    "delete_source_after_success": true
  },
  "analysis": {
    "crv_root": "vendor/reserved/video/claude-real-video",
    "max_frames": 140,
    "fps_floor": 1.0,
    "scene_threshold": 0.3,
    "dedup_threshold": 8.0,
    "report": true,
    "transcribe": false,
    "agent": {
      "enabled": true,
      "provider": "codex-native",
      "review_all_contact_sheets": true
    }
  },
  "knowledge": {
