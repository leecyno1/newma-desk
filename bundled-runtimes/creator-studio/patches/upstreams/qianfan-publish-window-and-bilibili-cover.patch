+def _positive_int_env(name: str, default: int) -> int:
+    try:
+        return max(1, int(os.getenv(name, str(default))))
+    except (TypeError, ValueError):
+        return default
+
+
+def _macos_secondary_position(width: int, height: int) -> tuple[int, int] | None:
+    if platform.system() != "Darwin":
+        return None
+    script = (
+        'ObjC.import("AppKit"); '
+        'JSON.stringify($.NSScreen.screens.js.map((s,i)=>{'
+        'const f=s.visibleFrame; return {index:i,x:Number(f.origin.x),y:Number(f.origin.y),'
+        'width:Number(f.size.width),height:Number(f.size.height)};}));'
+    )
+    try:
+        result = subprocess.run(
+            ["osascript", "-l", "JavaScript", "-e", script],
+            capture_output=True,
+            text=True,
+            check=False,
+            timeout=3,
+        )
+        screens = json.loads(result.stdout.strip() or "[]") if result.returncode == 0 else []
+    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
+        return None
+    if not isinstance(screens, list) or len(screens) < 2 or not isinstance(screens[1], dict):
+        return None
+    target = screens[1]
+    margin = 40
+    try:
+        x = int(target["x"]) + int(target["width"]) - width - margin
+        y = int(target["y"]) + margin
+    except (KeyError, TypeError, ValueError):
+        return None
+    return x, y
+
+
+def headed_window_args() -> list[str]:
+    """Keep visible publish browsers small and off the primary display when possible."""
+    width = _positive_int_env("DASHENG_PUBLISH_WINDOW_WIDTH", 1180)
+    height = _positive_int_env("DASHENG_PUBLISH_WINDOW_HEIGHT", 780)
+    try:
+        x = int(os.environ["DASHENG_PUBLISH_WINDOW_X"])
+        y = int(os.environ["DASHENG_PUBLISH_WINDOW_Y"])
+    except (KeyError, TypeError, ValueError):
+        position = _macos_secondary_position(width, height)
+        x, y = position if position is not None else (40, 40)
+    return [f"--window-size={width},{height}", f"--window-position={x},{y}"]
+
+
+def _frontmost_app_name() -> str | None:
+    if platform.system() != "Darwin":
+        return None
+    try:
+        result = subprocess.run(
+            [
+                "osascript",
+                "-e",
+                'tell application "System Events" to get name of first application process whose frontmost is true',
+            ],
+            capture_output=True,
+            text=True,
+            check=False,
+            timeout=2,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    name = result.stdout.strip()
+    return name if result.returncode == 0 and name else None
+
+
+def _restore_frontmost_app(name: str | None) -> None:
+    if platform.system() != "Darwin" or not name:
+        return
+    escaped = name.replace("\\", "\\\\").replace('"', '\\"')
+    try:
+        subprocess.run(
+            [
+                "osascript",
+                "-e",
+                f'tell application "System Events" to set frontmost of first application process whose name is "{escaped}" to true',
+            ],
+            capture_output=True,
+            text=True,
+            check=False,
+            timeout=2,
+        )
+    except (OSError, subprocess.SubprocessError):
+        pass
+
