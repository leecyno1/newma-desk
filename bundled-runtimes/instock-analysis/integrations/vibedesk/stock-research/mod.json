{
  "schemaVersion": "1.0",
  "id": "instock-stock-research",
  "name": "股票研究档案",
  "description": "统一 CZSC 技术结构、财务估值、公告、研报、新闻和产业链引用的可审计单股研究档案。",
  "version": "0.17.0",
  "publisher": "InStock Integration",
  "upstream": "https://github.com/myhhub/stock",
  "tags": ["A股", "股票研究", "基本面", "估值", "CZSC", "证据档案"],
  "agentWorkspace": {"type": "runtime", "runtimeId": "instock", "workspaceName": "source"},
  "runtime": {"type": "external", "baseUrlEnv": "NEWMA_DESK_INSTOCK_WEB_URL", "defaultBaseUrl": "http://127.0.0.1:9988", "route": "/mods/stock-research"},
  "manifest": {
    "schemaVersion": "1.1",
    "category": "research",
    "navigation": {
      "groupLabel": "量化研究", "groupOrder": 120, "itemOrder": 6, "label": "股票研究档案",
      "directory": {"id": "instock-suite", "label": "InStock 分析", "order": 20},
      "project": {"id": "quant-research", "name": "量化研究", "order": 120, "description": "A 股候选、单股研究、结构、轮动与验证。"},
      "icon": "research"
    },
    "compatibility": {"level": 2, "bridgeProtocol": "1.0"},
    "permissions": ["analysis.read"],
    "dataServices": ["instock-analysis"],
    "actions": {
      "analysis.stock-statement-announcements": {"binding":{"type":"data","service":"instock-analysis","capability":"analysis.stock-statement-announcements"},"execution":"request","permission":"analysis.read","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["symbol"],"properties":{"symbol":{"type":"string","pattern":"^[0-9]{6}(\\.(SH|SZ|BJ))?$"}},"additionalProperties":false},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["ok","data","meta"],"properties":{"ok":{"const":true},"meta":{"type":"object"},"data":{"type":"object","required":["symbol","source","items","begin","end","hasMore","boundary"],"properties":{"symbol":{"type":"string"},"source":{"const":"cninfo"},"items":{"type":"array"},"begin":{"type":"string","format":"date"},"end":{"type":"string","format":"date"},"hasMore":{"type":"boolean"},"boundary":{"type":"string"}}}}},"confirmation":"none","timeoutSeconds":120},
      "analysis.stock-statement-evidence": {"binding":{"type":"data","service":"instock-analysis","capability":"analysis.stock-statement-evidence"},"execution":"request","permission":"analysis.read","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["symbol","announcementId"],"properties":{"symbol":{"type":"string","pattern":"^[0-9]{6}(\\.(SH|SZ|BJ))?$"},"announcementId":{"type":"string","pattern":"^(AN[0-9]{10,30}|[0-9]{10,20})$"},"source":{"enum":["eastmoney","cninfo"],"default":"eastmoney"}},"additionalProperties":false},"outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["ok","data","meta"],"properties":{"ok":{"const":true},"meta":{"type":"object"},"data":{"type":"object","required":["symbol","announcementId","announcementSource","periodEnd","facts","pdfUrl","contentOrigin"],"properties":{"symbol":{"type":"string"},"announcementId":{"type":"string"},"announcementSource":{"enum":["eastmoney","cninfo"]},"periodEnd":{"type":"string","format":"date"},"facts":{"type":"array"},"pdfUrl":{"type":"string","format":"uri"},"contentOrigin":{"const":"pdf-text"}}}}},"confirmation":"none","timeoutSeconds":120},
      "analysis.stock-research": {
        "binding": {"type": "data", "capability": "analysis.stock-research"},
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["symbol"], "properties": {"symbol": {"type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"}, "period": {"enum": ["daily", "weekly", "monthly"]}, "bars": {"enum": [120, 240, 480, 800]}, "asOf": {"type": "string", "format": "date"}, "industryChainSnapshotId": {"type": "string", "minLength": 1, "maxLength": 160}, "eventFlowSnapshotId": {"type": "string", "minLength": 1, "maxLength": 160}, "refresh": {"enum": ["0", "1"]}}, "additionalProperties": false},
        "outputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["ok", "data", "meta"], "properties": {"ok": {"const": true}, "data": {"type": "object"}, "meta": {"type": "object"}}},
        "confirmation": "none",
        "timeoutSeconds": 120
      }
    },
    "events": {"emits": ["security.selected"], "accepts": ["security.selected"]},
    "refresh": {"mode": "manual"}
  }
}
