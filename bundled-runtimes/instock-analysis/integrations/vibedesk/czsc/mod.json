{
  "schemaVersion": "1.0",
  "id": "instock-czsc",
  "name": "缠论结构分析",
  "description": "基于官方 CZSC 的分型、笔、中枢和当前结构信号可视化，历史启发式标记与官方信号明确分层。",
  "version": "0.17.0",
  "publisher": "InStock Integration",
  "upstream": "https://github.com/myhhub/stock",
  "tags": ["CZSC", "缠论", "K线", "结构分析"],
  "agentWorkspace": {"type": "runtime", "runtimeId": "instock", "workspaceName": "source"},
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INSTOCK_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:9988",
    "route": "/mods/czsc"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "quant",
    "navigation": {
      "groupLabel": "量化研究",
      "groupOrder": 120,
      "itemOrder": 7,
      "label": "缠论结构分析",
      "directory": {
        "id": "instock-suite",
        "label": "InStock 分析",
        "order": 20
      },
      "project": {
        "id": "quant-research",
        "name": "量化研究",
        "order": 120,
        "description": "因子、策略、回测、相关性与量化实验。"
      },
      "icon": "quant"
    },
    "compatibility": {"level": 2, "bridgeProtocol": "1.0"},
    "permissions": ["analysis.read"],
    "dataServices": [],
    "actions": {
      "analysis.czsc": {
        "binding": {"type": "data", "capability": "analysis.czsc"},
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "code": {"type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"},
            "period": {"enum": ["daily", "weekly", "monthly"]},
            "bars": {"enum": [120, 240, 480, 800]},
            "asOf": {"type": "string", "format": "date"},
            "refresh": {"enum": ["0", "1"]}
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": {"const": true},
            "data": {"type": "object"},
            "meta": {"type": "object"}
          }
        },
        "confirmation": "none",
        "timeoutSeconds": 30
      },
      "analysis.czsc.scan": {
        "binding": {"type": "data", "capability": "analysis.czsc.scan"},
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["symbols"],
          "properties": {
            "symbols": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"}
            },
            "period": {"enum": ["daily", "weekly", "monthly"]},
            "bars": {"enum": [120, 240, 480, 800]},
            "asOf": {"type": "string", "format": "date"},
            "maxWorkers": {"type": "integer", "minimum": 1, "maximum": 4}
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": {"const": true},
            "data": {"type": "object", "required": ["scan_id", "status", "parameters", "progress"]},
            "meta": {"type": "object"}
          }
        },
        "confirmation": "none",
        "timeoutSeconds": 10
      }
    },
    "events": {"emits": [], "accepts": ["security.selected"]},
    "refresh": {"mode": "manual"}
  }
}
