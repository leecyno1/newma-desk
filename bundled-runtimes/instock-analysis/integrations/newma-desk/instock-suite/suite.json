    {
      "id": "instock-czsc",
      "name": "缠论结构分析",
      "description": "基于官方 CZSC 的分型、笔、中枢和当前结构信号可视化，历史启发式标记与官方信号明确分层。",
      "tags": ["CZSC", "缠论", "K线", "结构分析"],
      "route": "/mods/czsc",
      "navigation": {
        "itemOrder": 7,
        "label": "缠论结构分析"
      },
      "manifest": {
        "events": {"emits": [], "accepts": ["security.selected"]},
        "actions": {
          "analysis.czsc": {
            "binding": {
              "type": "data",
              "capability": "analysis.czsc"
            },
            "execution": "request",
            "permission": "analysis.read",
            "inputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"
                },
                "period": {
                  "enum": ["daily", "weekly", "monthly"]
                },
                "bars": {
                  "enum": [120, 240, 480, 800]
                },
                "asOf": {
                  "type": "string",
                  "format": "date"
                },
                "refresh": {"enum": ["0", "1"]}
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "required": ["ok", "data", "meta"],
              "properties": {
                "ok": {"const": true},
                "data": {"type": "object"},
                "meta": {"type": "object"}
              }
            },
            "confirmation": "none",
            "timeoutSeconds": 30
          },
          "analysis.czsc.scan": {
            "binding": {
              "type": "data",
              "capability": "analysis.czsc.scan"
            },
            "execution": "request",
            "permission": "analysis.read",
            "inputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "required": ["symbols"],
              "properties": {
                "symbols": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"
                  }
                },
                "period": {"enum": ["daily", "weekly", "monthly"]},
                "bars": {"enum": [120, 240, 480, 800]},
                "asOf": {"type": "string", "format": "date"},
                "maxWorkers": {"type": "integer", "minimum": 1, "maximum": 4}
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "required": ["ok", "data", "meta"],
              "properties": {
                "ok": {"const": true},
                "data": {
                  "type": "object",
                  "required": ["scan_id", "status", "parameters", "progress"]
                },
                "meta": {"type": "object"}
              }
            },
            "confirmation": "none",
            "timeoutSeconds": 10
          }
        }
      },
      "defaultInstall": true
    },
