{
  "id": "instock-analysis",
  "name": "InStock 分析服务",
  "description": "提供 A 股候选、股票研究档案、单标的与批量 CZSC 结构分析，以及行业、ETF 轮动快照和稳健性实验。",
  "priority": 30,
  "baseUrl": "http://127.0.0.1:9988/api/v1",
  "healthPath": "/health",
  "transport": "rest",
  "capabilities": {
    "analysis.czsc": {
      "method": "GET",
      "path": "/czsc/analyses",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {"type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"},
          "period": {"enum": ["daily", "weekly", "monthly"]},
          "bars": {"enum": [120, 240, 480, 800]},
          "asOf": {"type": "string", "format": "date"},
          "refresh": {"enum": ["0", "1"]}
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "required": ["symbol", "period", "end_date", "engine", "summary", "evidence", "structure", "chart", "data_source", "snapshot"],
            "properties": {
              "symbol": {"type": "string"},
              "period": {"type": "string"},
              "end_date": {"type": "string"},
              "engine": {"type": "object"},
              "summary": {"type": "object"},
              "evidence": {
                "type": "object",
                "required": ["schema_version", "method", "structure_stability", "latest_structure_change", "input_quality"]
              },
              "structure": {"type": "object"},
              "chart": {"type": "object"},
              "data_source": {"type": "string"},
              "snapshot": {
                "type": "object",
                "required": ["schema_version", "snapshot_id", "analysis", "data_window", "provenance", "freshness", "input", "result"]
              }
            },
            "additionalProperties": true
          },
          "meta": {"type": "object", "required": ["api_version", "request_id"]}
        },
        "additionalProperties": false
      },
      "permission": "analysis.read"
    },
    "analysis.czsc.scan": {
      "method": "POST",
      "path": "/czsc/scans",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["symbols"],
        "properties": {
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$"}
          },
          "period": {"enum": ["daily", "weekly", "monthly"]},
          "bars": {"enum": [120, 240, 480, 800]},
          "asOf": {"type": "string", "format": "date"},
          "maxWorkers": {"type": "integer", "minimum": 1, "maximum": 4}
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "required": ["scan_id", "status", "created_at", "parameters", "progress", "result", "error"],
            "properties": {
              "scan_id": {"type": "string", "pattern": "^czsc-scan-[a-f0-9]{32}$"},
              "status": {"enum": ["queued", "running", "cancelling", "completed", "cancelled", "failed"]},
              "created_at": {"type": "string", "format": "date-time"},
              "parameters": {"type": "object"},
              "progress": {
                "type": "object",
                "required": ["total", "completed", "succeeded", "failed", "cancel_requested"]
              },
              "result": {"type": ["object", "null"]},
              "error": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "meta": {"type": "object", "required": ["api_version", "request_id"]}
        },
        "additionalProperties": false
      },
      "permission": "analysis.read"
    },
    "analysis.rotation": {
      "method": "GET",
      "path": "/rotations/snapshots",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "window": {"enum": [40, 60, 120]},
          "benchmark": {"type": "string", "pattern": "^[0-9]{6}$"},
          "refresh": {"enum": ["0", "1"]},
          "asOf": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "required": ["as_of", "window", "benchmark", "data_source", "data_state", "signal_state", "index_signal_count", "signal_fallback_count", "summary", "market_breadth", "etfs", "snapshot"],
            "properties": {
              "as_of": {"type": "string"},
              "window": {"type": "integer"},
              "benchmark": {"type": "object"},
              "data_source": {"type": "string"},
              "data_state": {"enum": ["complete", "partial"]},
              "signal_state": {"enum": ["complete", "partial", "fallback"]},
              "index_signal_count": {"type": "integer", "minimum": 0},
              "signal_fallback_count": {"type": "integer", "minimum": 0},
              "signal_failures": {"type": "array"},
              "summary": {"type": "object"},
              "market_breadth": {
                "type": "object",
                "required": ["state", "breadth", "up", "down", "flat", "up_ratio"],
                "properties": {
                  "state": {"enum": ["available", "unavailable"]},
                  "breadth": {"type": "string"},
                  "up": {"type": "integer", "minimum": 0},
                  "down": {"type": "integer", "minimum": 0},
                  "flat": {"type": "integer", "minimum": 0},
                  "up_ratio": {"type": "number", "minimum": 0, "maximum": 100}
                },
                "additionalProperties": true
              },
              "etfs": {"type": "array"},
              "snapshot": {
                "type": "object",
                "required": ["schema_version", "snapshot_id", "analysis", "data_window", "provenance", "freshness", "input", "result"]
              }
            },
            "additionalProperties": true
          },
          "meta": {"type": "object", "required": ["api_version", "request_id"]}
        },
        "additionalProperties": false
      },
      "permission": "analysis.read"
    },
    "analysis.rotation.experiment": {
      "method": "GET",
      "path": "/rotations/experiments",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "benchmark": {"type": "string", "pattern": "^[0-9]{6}$"},
          "rebalanceDays": {"enum": [5, 10, 20]},
          "costBps": {"enum": [10, 25, 50]},
