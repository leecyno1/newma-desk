        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {"const": true},
          "data": {
            "type": "object",
            "required": ["engine", "as_of", "data_source", "rules", "data_quality", "selected_variant", "parameter_surface", "stress_tests", "equity_curve", "verdict", "summary", "limitations", "snapshot"],
            "properties": {
              "engine": {"type": "object"},
              "as_of": {"type": "string"},
              "data_source": {"type": "string"},
              "rules": {"type": "object"},
              "data_quality": {"type": "object"},
              "selected_variant": {"type": "object"},
              "parameter_surface": {"type": "array", "minItems": 9, "maxItems": 9},
              "stress_tests": {"type": "array", "minItems": 3, "maxItems": 3},
              "equity_curve": {"type": "array"},
              "verdict": {"type": "object", "required": ["state", "label", "reasons"]},
              "summary": {"type": "object"},
              "limitations": {"type": "array"},
              "snapshot": {
                "type": "object",
                "required": ["schema_version", "snapshot_id", "analysis", "data_window", "provenance", "freshness", "input", "result"]
              }
            },
            "additionalProperties": true
          },
          "meta": {"type": "object", "required": ["api_version", "request_id"]}
        },
        "additionalProperties": false
      },
      "permission": "analysis.read"
    },
    "analysis.industry-chain": {
      "method": "POST",
      "path": "/industry-chain/research",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["schema_version", "theme", "market", "as_of", "evidence", "chain", "layers", "candidates"],
        "properties": {
          "schema_version": {"const": "2.0"},
          "theme": {"type": "string", "minLength": 1, "maxLength": 160},
          "market": {"enum": ["CN", "HK", "US", "TW", "JP", "KR", "EU", "GLOBAL"]},
          "as_of": {"type": "string", "format": "date"},
          "notes": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"type": "object"}},
          "chain": {
            "type": "object",
            "required": ["nodes", "links"],
            "properties": {
              "nodes": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"type": "object"}},
              "links": {"type": "array", "maxItems": 120, "items": {"type": "object"}}
            },
            "additionalProperties": false
          },
          "layers": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}},
          "candidates": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}}
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {"const": true},
          "data": {"type": "object", "required": ["engine", "schema_version", "canonical_schema_version", "chain", "layers", "candidates", "snapshot"]},
          "meta": {"type": "object", "required": ["api_version", "request_id"]}
        },
        "additionalProperties": false
      },
      "permission": "analysis.read"
    },
