# Deepsee — Environment Template
# Copy to .env and fill in your credentials.

# === Chatlog / 微信本地兜底 ===
CHATLOG_HTTP_BASE=http://127.0.0.1:5030
# WeChat raw data directory.
# macOS example: /Users/<user>/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/<wxid>
# Windows example: C:\Users\<user>\Documents\WeChat Files\<wxid>
CHATLOG_DATA_DIR=/path/to/xwechat_files/your_wxid
# Chatlog decrypted work directory.
# macOS example: /Users/<user>/Documents/chatlog/<wxid>
# Windows example: C:\Users\<user>\Documents\chatlog\<wxid>
CHATLOG_DIR=/path/to/chatlog/your_wxid
CHATLOG_WORK_DIR=/path/to/chatlog/your_wxid
CHATLOG_HTTP_SESSION_TIMEOUT_SECONDS=5
CHATLOG_HTTP_TIMEOUT_SECONDS=10
# Optional sidecar controls.
# macOS: scripts/chatlog_sidecar.sh
# Windows: scripts/run_chatlog_windows.ps1
CHATLOG_BIN=/path/to/chatlog
CHATLOG_GRAY_PORT=5031
CHATLOG_STARTUP_TIMEOUT_SECONDS=45
CHATLOG_AUTO_DECRYPT=0
# macOS=darwin, Windows=windows
CHATLOG_PLATFORM=darwin
CHATLOG_VERSION=4

# wx-cli fallback source. Install with:
# python scripts/install_wechat_local_deps.py --tool wx_cli
WX_CLI_BIN=/path/to/wx
WX_CLI_TIMEOUT_SECONDS=45
WX_CLI_SESSION_LIMIT=200

# === n8n Webhooks (optional) ===
N8N_REPLY_WEBHOOK=
N8N_SUMMARY_WEBHOOK=
N8N_CONTACT_WEBHOOK=
N8N_SEND_WEBHOOK=
N8N_AUTH_TOKEN=

# === API Auth ===
API_TOKEN=your-api-token-here
API_AUTH_REQUIRED=false
AGENT_API_TOKEN=your-agent-api-token-here

# === Database ===
DATABASE_URL=sqlite:///./data/app.db

# === Media Server ===
MEDIA_SERVER_BASE=http://127.0.0.1:8001
MEDIA_COLLECTOR_DAILY_ENABLED=true
MEDIA_COLLECTOR_DAILY_HOUR=5
MEDIA_COLLECTOR_DAILY_MINUTE=0
MEDIA_COLLECTOR_TIMEOUT_SECONDS=240
# When a fresh clone has no data/hot data yet, the media page can initialize
# once from the built-in media-collector default sources.
MEDIA_COLLECTOR_AUTO_BOOTSTRAP=true
MEDIA_COLLECTOR_BOOTSTRAP_TIMEOUT_SECONDS=60
# Cleans cache records and cached files older than 30 days; recent cache is preserved.
MEDIA_CACHE_CLEANUP_ENABLED=true
MEDIA_CACHE_TTL_HOURS=720
MEDIA_CACHE_MAX_MB=256
MEDIA_CACHE_CLEANUP_INTERVAL_SECONDS=86400

# === Local Content Engines ===
# News/self-media/MP modules default to local persisted sources for speed and offline stability.
NEWS_DATASET_DIR=./data/datasets
NEWS_REMOTE_ENABLED=0
NEWS_ONLINE_TRANSLATION_ENABLED=0
COLLECTOR_DATA_DIR=./data
WE_MP_RSS_DB=
WE_MP_RSS_DIR=
MP_REMOTE_ENABLED=0

# === Server ===
HOST=127.0.0.1
PORT=8001

# === Sync (seconds; 0 = manual trigger only) ===
SYNC_INTERVAL_SECONDS=0
SUMMARY_OVERLAY_INTERVAL_SECONDS=3600
NEWSNOW_REFRESH_INTERVAL_SECONDS=3600

# === AI ===
AI_MAX_PARALLEL=12
# LLM API key for Dasheng Cloud / ShuiMu compute preset
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://app.watertimber.us/v1
SILICONFLOW_MODEL=gpt-5.5
SILICONFLOW_TOOL_MODEL=MiniMax-M3
AI_MAX_PARALLEL=32
# Newma-Desk Agent batch route (opt in after selecting a batch CLI in Desk)
DESK_AGENT_ENABLED=false
DESK_AGENT_BASE_URL=http://127.0.0.1:8911
DESK_AGENT_MODULE_ID=deepsee-news
DESK_AGENT_TIMEOUT_SECONDS=180
# One-page poster export. auto=image first with local infographic fallback.
ONEPAGE_IMAGE_MODE=auto
ONEPAGE_IMAGE_API_URL=
ONEPAGE_IMAGE_API_KEY=
ONEPAGE_IMAGE_MODEL=MiniMax-M3
ONEPAGE_IMAGE_SIZE=1024x1536
ONEPAGE_IMAGE_QUALITY=medium
# MiniMax API key for WeChat auto-reply route
MINIMAX_API_KEY=your-minimax-api-key
WECHAT_FALLBACK_API_KEY=
WECHAT_FALLBACK_API_BASE=https://api.minimaxi.com/v1
WECHAT_FALLBACK_MODEL=MiniMax-M3
WECHAT_LOCAL_MINIMAX_ENABLED=true
WECHAT_HERMES_BACKUP_ENABLED=false
