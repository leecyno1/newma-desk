{
  "version": "1.0",
  "title": "市场行情",
  "blocks": [
    {
      "id": "market-actions",
      "type": "actions",
      "items": [
        {
          "id": "refresh",
          "label": "刷新行情",
          "capability": "market.refresh"
        },
        {
          "id": "explain",
          "label": "解释行情",
          "capability": "market.explain"
        }
      ]
    },
    {
      "id": "breadth",
      "type": "metrics",
      "title": "市场宽度",
      "items": [
        { "label": "上涨", "valuePath": "breadth.up", "format": "number" },
        { "label": "下跌", "valuePath": "breadth.down", "format": "number" },
        { "label": "平盘", "valuePath": "breadth.flat", "format": "number" }
      ]
    },
    {
      "id": "index-trend",
      "type": "chart",
      "title": "主要指数涨跌幅",
      "optionPath": "charts.indexTrend",
      "height": 320
    },
    {
      "id": "global-indices",
      "type": "table",
      "title": "全球指数",
      "rowsPath": "globalIndices",
      "columns": [
        { "key": "name", "label": "指数" },
        { "key": "region", "label": "市场" },
        { "key": "price", "label": "点位", "format": "number" },
        { "key": "changePct", "label": "涨跌幅", "format": "percent", "sortable": true }
      ],
      "emptyText": "暂无全球指数数据"
    },
    {
      "id": "leaders",
      "type": "table",
      "title": "成交额榜",
      "rowsPath": "leaders",
      "columns": [
        { "key": "symbol", "label": "代码" },
        { "key": "name", "label": "名称" },
        { "key": "price", "label": "现价", "format": "number", "sortable": true },
        { "key": "changePct", "label": "涨跌幅", "format": "percent", "sortable": true },
        { "key": "amount", "label": "成交额", "format": "number", "sortable": true },
        { "key": "industry", "label": "行业" }
      ],
      "emptyText": "暂无成交额榜数据"
    }
  ]
}
