{
  "schemaVersion": "1.0",
  "id": "market-daily",
  "name": "市场行情",
  "version": "0.1.0",
  "category": "market",
  "navigation": {
    "groupLabel": "市场",
    "groupOrder": 20,
    "itemOrder": 10,
    "icon": "market"
  },
  "entry": {
    "type": "structured",
    "url": "/mods/market-daily/"
