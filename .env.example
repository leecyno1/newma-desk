NEWMA_DOCK_RUNTIME_DIR=runtime
NEWMA_DOCK_DATABASE_PATH=runtime/newma-dock.db
NEWMA_DOCK_ALLOWED_ORIGINS=http://127.0.0.1:5888,http://127.0.0.1:5891,http://127.0.0.1:8911,http://127.0.0.1:4174,http://127.0.0.1:8001,http://127.0.0.1:9988,http://127.0.0.1:3001,http://127.0.0.1:8011
NEWMA_DOCK_ENABLE_DOMAIN_SUITES=true
NEWMA_DOCK_MODEL_DEFAULT_ADAPTER=openai-compatible
NEWMA_DOCK_OPENAI_BASE_URL=https://api.openai.com/v1
NEWMA_DOCK_OPENAI_API_KEY=
NEWMA_DOCK_OPENAI_MODEL=gpt-5.6
NEWMA_DOCK_OPENAI_API_KEY_REQUIRED=true
NEWMA_DOCK_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NEWMA_DOCK_ANTHROPIC_API_KEY=
NEWMA_DOCK_ANTHROPIC_MODEL=claude-sonnet-4-5
NEWMA_DOCK_ANTHROPIC_VERSION=2023-06-01
NEWMA_DOCK_ANTHROPIC_MAX_TOKENS=4096
NEWMA_DOCK_MODEL_TIMEOUT_SECONDS=120
NEWMA_DOCK_AGENT_DEFAULT_ADAPTER=codex-cli
NEWMA_DOCK_AGENT_TIMEOUT_SECONDS=300
NEWMA_DOCK_WORKSPACE_ROOT=.
NEWMA_DOCK_INVESTMENT_WORKSPACE=mod-projects/vibe-research
NEWMA_DOCK_TRADING_WORKSPACE=mod-projects/vibe-trading
# External Mod Runtime discovery roots. Empty values use the defaults from
# config/external-mod-runtimes.json (repository parent and ~/Desktop/Projects).
