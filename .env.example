VIBEDESK_RUNTIME_DIR=runtime
VIBEDESK_DATABASE_PATH=runtime/vibedesk.db
VIBEDESK_ALLOWED_ORIGINS=http://127.0.0.1:5888,http://127.0.0.1:5891
VIBEDESK_MODEL_DEFAULT_ADAPTER=openai-compatible
VIBEDESK_OPENAI_BASE_URL=https://api.openai.com/v1
VIBEDESK_OPENAI_API_KEY=
