VIBEDESK_OPENAI_API_KEY_REQUIRED=true
VIBEDESK_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
VIBEDESK_ANTHROPIC_API_KEY=
VIBEDESK_ANTHROPIC_MODEL=claude-sonnet-4-5
VIBEDESK_ANTHROPIC_VERSION=2023-06-01
VIBEDESK_ANTHROPIC_MAX_TOKENS=4096
VIBEDESK_MODEL_TIMEOUT_SECONDS=120
VIBEDESK_AGENT_DEFAULT_ADAPTER=hermes-webui
VIBEDESK_AGENT_TIMEOUT_SECONDS=120
VIBEDESK_HERMES_WEBUI_BASE_URL=http://127.0.0.1:8787
VIBEDESK_HERMES_WEBUI_COOKIE=
VIBEDESK_HERMES_WEBUI_CSRF_TOKEN=
VIBEDESK_HERMES_WEBUI_WORKSPACE=
VIBEDESK_DATA_SERVICE_PUBLIC_MODE=false
VIBEDESK_TRADE_CONFIRMATION_SECRET=
VIBEDESK_RESEARCH_BASE_URL=http://127.0.0.1:8900
VIBEDESK_RESEARCH_API_KEY=
VIBEDESK_ENABLE_SCHEDULER=false
VIBEDESK_SCHEDULER_POLL_SECONDS=30
