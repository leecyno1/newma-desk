NEWMA_DOCK_DESKTOP_PROJECTS_ROOT=
NEWMA_DOCK_DEEPSEE_WORKSPACE=
NEWMA_DOCK_SEVEN_CYCLE_WORKSPACE=
NEWMA_DOCK_INSTOCK_WORKSPACE=
NEWMA_DOCK_ORCHESTRA_FRONTEND_WORKSPACE=
NEWMA_DOCK_ORCHESTRA_BACKEND_WORKSPACE=
