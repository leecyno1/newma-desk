NEWMA_DESK_RUNTIME_DIR=runtime
NEWMA_DESK_DATABASE_PATH=runtime/newma-desk.db
# Optional override; the unified stack defaults to runtime/newma-desk-stack.pid.
# NEWMA_DESK_STACK_PID_FILE=runtime/newma-desk-stack.pid
NEWMA_DESK_ALLOWED_ORIGINS=http://127.0.0.1:5888,http://127.0.0.1:5891,http://127.0.0.1:8911,http://127.0.0.1:4174,http://127.0.0.1:8001,http://127.0.0.1:9988,http://127.0.0.1:3001,http://127.0.0.1:8011
NEWMA_DESK_ENABLE_DOMAIN_SUITES=true
NEWMA_DESK_MODEL_DEFAULT_ADAPTER=openai-compatible
NEWMA_DESK_OPENAI_BASE_URL=https://api.openai.com/v1
NEWMA_DESK_OPENAI_API_KEY=
NEWMA_DESK_OPENAI_MODEL=gpt-5.6
# Comma-separated failover models used only when the default model is
# temporarily rate-limited or unavailable. Explicit per-request models do not
# fall back silently.
NEWMA_DESK_OPENAI_FALLBACK_MODELS=
NEWMA_DESK_OPENAI_API_KEY_REQUIRED=true
NEWMA_DESK_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NEWMA_DESK_ANTHROPIC_API_KEY=
NEWMA_DESK_ANTHROPIC_MODEL=claude-sonnet-4-5
NEWMA_DESK_ANTHROPIC_VERSION=2023-06-01
NEWMA_DESK_ANTHROPIC_MAX_TOKENS=4096
NEWMA_DESK_MODEL_TIMEOUT_SECONDS=120
NEWMA_DESK_AGENT_DEFAULT_ADAPTER=codex-cli
NEWMA_DESK_AGENT_TIMEOUT_SECONDS=300
NEWMA_DESK_WORKSPACE_ROOT=.
NEWMA_DESK_INVESTMENT_WORKSPACE=mod-projects/vibe-research
NEWMA_DESK_TRADING_WORKSPACE=mod-projects/vibe-trading
# External Mod Runtime discovery roots. Empty values use the defaults from
# config/external-mod-runtimes.json (repository parent and ~/Desktop/Projects).
NEWMA_DESK_PROJECTS_ROOT=
NEWMA_DESK_DESKTOP_PROJECTS_ROOT=
NEWMA_DESK_DEEPSEE_WORKSPACE=
NEWMA_DESK_SEVEN_CYCLE_WORKSPACE=
NEWMA_DESK_INSTOCK_WORKSPACE=
NEWMA_DESK_ORCHESTRA_FRONTEND_WORKSPACE=
NEWMA_DESK_ORCHESTRA_BACKEND_WORKSPACE=
# Optional JSON object for exact Mod-to-workspace overrides.
NEWMA_DESK_MOD_WORKSPACE_OVERRIDES={}
NEWMA_DESK_INVESTMENT_WEB_URL=http://127.0.0.1:8911
NEWMA_DESK_TRADING_WEB_URL=http://127.0.0.1:8911
NEWMA_DESK_SEVEN_CYCLE_WEB_URL=http://127.0.0.1:4174
# Allow slower Catalog-backed health checks on external or removable disks.
NEWMA_DESK_SEVEN_CYCLE_HEALTH_TIMEOUT_MS=5000
# Strictly repairs only verified filesystem-device drift; set 0 to disable.
NEWMA_DESK_SEVEN_CYCLE_REPAIR_CATALOG_ON_START=1
NEWMA_DESK_DEEPSEE_WEB_URL=http://127.0.0.1:8001
NEWMA_DESK_INSTOCK_WEB_URL=http://127.0.0.1:9988
NEWMA_DESK_ORCHESTRA_WEB_URL=http://127.0.0.1:3001
NEWMA_DESK_ORCHESTRA_API_URL=http://127.0.0.1:8011
NEWMA_DESK_MOD_STORE_DIR=mods
NEWMA_DESK_MOD_STORE_GIT_TIMEOUT_SECONDS=15
NEWMA_DESK_HERMES_WEBUI_BASE_URL=http://127.0.0.1:8787
NEWMA_DESK_HERMES_WEBUI_COOKIE=
NEWMA_DESK_HERMES_WEBUI_CSRF_TOKEN=
NEWMA_DESK_HERMES_WEBUI_WORKSPACE=
NEWMA_DESK_DATA_SERVICE_DIRS=integrations
NEWMA_DESK_DATA_SERVICE_PUBLIC_MODE=false
NEWMA_DESK_MOD_SESSION_SECRET=
NEWMA_DESK_MOD_SESSION_TTL_SECONDS=900
NEWMA_DESK_TRADE_CONFIRMATION_SECRET=
NEWMA_DESK_RESEARCH_BASE_URL=http://127.0.0.1:8911/api/research
NEWMA_DESK_RESEARCH_API_KEY=
# Server-side credential used by the integrated Trading bridge. The browser
# never receives this value; the Desk host adds it to mounted Trading calls.
NEWMA_DESK_TRADING_API_KEY=
NEWMA_DESK_ENABLE_SCHEDULER=false
NEWMA_DESK_SCHEDULER_POLL_SECONDS=30
