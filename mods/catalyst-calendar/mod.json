{
  "schemaVersion": "1.0",
  "id": "catalyst-calendar",
  "name": "催化剂日历",
  "description": "聚合财报预约、解禁、宏观周期观察窗和用户自定义事件，记录来源、新鲜度、确认条件、失效条件与实际结果。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": ["催化剂", "事件日历", "财报", "宏观周期"],
  "agentWorkspace": {
    "type": "runtime",
    "runtimeId": "vibe-research",
    "workspaceName": "source"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/research/catalyst-calendar"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "情报",
      "groupOrder": 0,
      "itemOrder": 30,
      "label": "催化剂日历",
      "directory": { "id": "event-suite", "label": "情报工具", "order": 5 },
      "project": {
        "id": "event-intelligence",
        "name": "情报",
        "order": 0,
        "description": "统一承载全球态势、新闻、政策、公告、冲突、灾害与舆情。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["market.read", "storage.read", "storage.write"],
    "dataServices": ["market-data"],
    "storage": {
      "mode": "desk-managed",
      "namespaces": [
        {
          "id": "catalyst-calendar",
          "scope": "user-workspace",
          "schemaVersion": 1,
          "quotaMb": 2,
          "maxItemKb": 128
        }
      ]
    },
    "actions": {},
    "events": {
      "emits": ["security.selected"],
      "accepts": ["security.selected"]
    }
  }
}
