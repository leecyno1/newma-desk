{
  "schemaVersion": "1.0",
  "id": "policy-interpretation",
  "name": "政策解读",
  "description": "由轻量 Agent 完成影响分析、同类政策历史对比与逐字稿条件检查。",
  "version": "0.2.0",
  "publisher": "Newma-Desk",
  "agentWorkspace": {"type": "desk"},
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/policy-analysis/?view=interpretation&mod=policy-interpretation"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "政策",
      "groupOrder": 20,
      "itemOrder": 2,
      "label": "政策解读",
      "directory": {"id": "policy-suite", "label": "政策研究", "order": 5},
      "project": {
        "id": "policy-intelligence",
        "name": "政策",
        "order": 20,
        "description": "政策日历、政策流、政策量级、历史对比与影响解读。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["investment.read"],
    "actions": {
      "policy.interpret": {
        "binding": {
          "type": "agent",
          "capability": "policy.interpret",
          "profile": "batch",
          "memoryScope": "task"
        },
        "execution": "task",
        "permission": "investment.read",
        "inputSchema": {
          "type": "object",
          "required": ["prompt", "policy"],
          "properties": {
            "prompt": {"type": "string", "minLength": 1, "maxLength": 12000},
            "policy": {"type": "object", "additionalProperties": true},
            "relatedPolicies": {
              "type": "array",
              "maxItems": 20,
              "items": {"type": "object", "additionalProperties": true}
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "required": ["id", "status"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "status": {"enum": ["queued", "running", "completed", "failed", "cancelled"]}
          }
        },
        "confirmation": "none",
        "timeoutSeconds": 300
      }
    },
    "events": {"emits": [], "accepts": []}
  }
}
