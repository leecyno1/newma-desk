    "navigation": {
      "groupLabel": "创作",
      "groupOrder": 140,
      "itemOrder": 10,
      "directory": {
        "id": "creator-studio-suite",
        "label": "Newma Creator Studio",
        "order": 10
      },
      "project": {
        "id": "creator-studio",
        "name": "创作",
        "order": 140,
        "description": "内容采集、研究转写、多媒体生产、发布与传播复盘。",
