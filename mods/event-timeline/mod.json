{
  "schemaVersion": "1.0",
  "id": "event-timeline",
  "name": "日线时间轴",
  "description": "把股票、ETF 与开放式基金的日线、公开事件和异动按交易日对齐。",
  "version": "0.4.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/leecyno1/newma-desk",
  "tags": ["日K", "ETF", "基金", "事件", "量价", "研究沉淀"],
  "agentWorkspace": { "type": "desk" },
  "runtime": { "type": "direct", "entry": { "type": "structured", "url": "/mods/market-daily/?workspace=event-timeline" } },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": { "groupLabel": "市场", "groupOrder": 40, "itemOrder": 20, "label": "日线时间轴", "directory": { "id": "market-suite", "label": "市场工具", "order": 5 }, "project": { "id": "market-surface", "name": "市场", "order": 40, "description": "行情、市场复盘、云图、技术结构、强弱、宽度与情绪。" }, "icon": "market" },
    "compatibility": { "level": 3, "bridgeProtocol": "1.0", "sdkVersion": "^0.1.0", "viewSpecVersion": "1.0" },
    "permissions": ["market.read"], "dataServices": [],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["security", "etf", "fund"],
      "concepts": ["events", "price-action"],
      "entrypoints": [
        {
          "id": "timeline",
          "intent": "event.timeline",
          "label": "日线事件",
          "contextContract": "newma.wiki.subject.v1",
          "defaults": { "period": "daily" }
        }
      ]
    },
    "actions": {
      "market.refresh": {
        "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "required": ["id", "moduleId", "data"], "properties": { "id": { "type": "string" }, "moduleId": { "const": "event-timeline" }, "data": { "type": "object" } } },
        "confirmation": "none"
      },
      "chart.set-indicator": {
        "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "required": ["position", "indicator"], "properties": { "position": { "enum": ["primary", "secondary"] }, "indicator": { "enum": ["MA", "EMA", "BOLL", "VOL", "MACD", "RSI", "KDJ"] } }, "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "market.set-alert": {
        "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "required": ["direction", "price"], "properties": { "direction": { "enum": ["above", "below"] }, "price": { "type": "number", "exclusiveMinimum": 0 }, "label": { "type": "string", "maxLength": 80 } }, "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "workspace.save-layout": {
        "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "properties": { "name": { "type": "string", "maxLength": 80 } }, "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "market.symbol-search": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } },
        "confirmation": "none"
      },
      "market.quote": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } },
        "confirmation": "none"
      },
      "market.ohlcv": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } },
        "confirmation": "none"
      },
      "market.announcements": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array" } } },
        "confirmation": "none"
      },
      "market.reports": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array" } } },
        "confirmation": "none"
      },
      "market.news": {
        "binding": { "type": "data" }, "execution": "request", "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": true },
        "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array" } } },
        "confirmation": "none"
      }
    },
    "events": { "emits": ["security.selected"], "accepts": ["security.selected"] }
  }
}
