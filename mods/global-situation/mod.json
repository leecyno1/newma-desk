{
  "schemaVersion": "1.0",
  "id": "global-situation",
  "name": "全球情报",
  "description": "Newma-Desk 默认首页：在综合地图中统一监控政策、冲突、灾害、军事、基础设施、新闻与市场异常信号。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/marc-shade/world-intel-mcp",
  "tags": ["全球态势", "地图", "驾驶舱", "跨资产", "World Intelligence"],
  "agentWorkspace": { "type": "desk" },
  "runtime": {
    "type": "direct",
    "entry": {
      "type": "structured",
      "url": "/mods/global-intelligence/"
    }
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "全球",
      "groupOrder": 0,
      "itemOrder": 0,
      "label": "全球情报",
      "directory": { "id": "global-suite", "label": "全球工具", "order": 5 },
      "project": {
        "id": "global-intelligence",
        "name": "全球",
        "order": 0,
        "description": "统一承载全球态势、新闻、冲突、灾害、事件与舆情。"
      },
      "icon": "market"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["market.read"],
    "dataServices": ["world-intel"],
    "actions": {
      "global-intel.refresh": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "global-intel.snapshot": {
        "binding": { "type": "data" },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "global-intel.static-map": {
        "binding": { "type": "data" },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "workspace.save-layout": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": {
          "type": "object",
          "properties": { "name": { "type": "string", "maxLength": 80 } },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      }
    },
    "events": { "emits": [], "accepts": [] }
  }
}
