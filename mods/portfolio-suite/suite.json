{
  "schemaVersion": "1.0",
  "id": "portfolio-suite",
  "name": "组合配置中心",
  "description": "跨资产战略配置、目标波动率、情景推演与配置评估。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/ghostfolio/ghostfolio",
  "tags": [
    "配置",
    "组合",
    "Portfolio"
  ],
  "agentWorkspace": {
    "type": "desk"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "配置",
      "groupOrder": 80,
      "itemOrder": 30,
      "directory": {
        "id": "portfolio-suite",
        "label": "组合配置",
        "order": 10
      },
      "project": {
        "id": "asset-allocation",
        "name": "配置",
        "order": 80,
        "description": "跨资产战略配置、目标波动率、周期观点与情景推演。"
      },
      "icon": "quant"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": [
      "portfolio.read",
      "portfolio.local-write"
    ],
    "dataServices": [
      "market-data"
    ],
    "actions": {
      "portfolio.refresh": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.import-legacy": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.local-write",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "user"
      },
      "portfolio.optimize": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.analyze-performance": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      }
    },
    "events": {
      "emits": [
        "security.selected"
      ],
      "accepts": [
        "security.selected"
      ]
    },
    "refresh": {
      "mode": "manual"
    }
  },
  "pages": [
    {
      "id": "portfolio-brief",
      "name": "配置总览",
      "description": "查看跨资产目标权重、预期收益、波动率与周期证据。",
      "tags": [
        "组合",
        "持仓",
        "总览"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-brief",
      "navigation": {
        "itemOrder": 10,
        "label": "总览"
      }
    },
    {
      "id": "portfolio-allocation",
      "name": "配置模型",
      "description": "使用 Black-Litterman、风险平价或最低波动生成目标配置。",
      "tags": [
        "资产配置",
        "组合优化",
        "PyPortfolioOpt"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-allocation",
      "navigation": {
        "itemOrder": 20,
        "label": "模型"
      }
    },
    {
      "id": "portfolio-scenarios",
      "name": "情景推演",
      "description": "观察增长、通胀、流动性和风险冲击下的组合变化。",
      "tags": [
        "情景",
        "压力测试",
        "宏观"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-scenarios",
      "navigation": {
        "itemOrder": 30,
        "label": "情景"
      }
    },
    {
      "id": "portfolio-performance",
      "name": "配置评估",
      "description": "拆解风险贡献、预期收益和周期信号可信度。",
      "tags": [
        "绩效",
        "归因",
        "收益",
        "QuantStats"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-performance",
      "navigation": {
        "itemOrder": 40,
        "label": "评估"
      }
    },
    {
      "id": "portfolio-settings",
      "name": "模型说明",
      "description": "查看模型假设、数据来源与证据边界。",
      "tags": [
        "设置",
        "账户",
        "迁移"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-settings",
      "navigation": {
        "itemOrder": 50,
        "label": "说明"
      }
    }
  ]
}
