{
  "schemaVersion": "1.0",
  "id": "portfolio-suite",
  "name": "组合资产中心",
  "description": "以交易流水为事实账本，统一管理多账户、跨市场持仓、研究覆盖、风险暴露、资产配置、绩效归因与组合设置。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/ghostfolio/ghostfolio",
  "tags": [
    "组合",
    "持仓",
    "风险",
    "绩效",
    "Ghostfolio"
  ],
  "agentWorkspace": {
    "type": "desk"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "交易、风控与组合管理",
      "groupOrder": 140,
      "itemOrder": 30,
      "directory": {
        "id": "portfolio-suite",
        "label": "组合资产中心",
        "order": 10
      },
      "project": {
        "id": "trading-risk-portfolio",
        "name": "交易、风控与组合管理",
        "order": 140,
        "description": "交易执行、风险控制、持仓、组合管理与绩效归因。"
      },
      "icon": "market"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": [
      "portfolio.read",
      "portfolio.local-write"
    ],
    "dataServices": [
      "market-data"
    ],
    "actions": {
      "portfolio.refresh": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.import-legacy": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.local-write",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "user"
      },
      "portfolio.optimize": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.analyze-performance": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      }
    },
    "events": {
      "emits": [
        "security.selected"
      ],
      "accepts": [
        "security.selected"
      ]
    },
    "refresh": {
      "mode": "manual"
    }
  },
  "pages": [
    {
      "id": "portfolio-brief",
      "name": "组合总览",
      "description": "查看多币种资产、当前持仓、研究覆盖、实时估值与市场配置。",
      "tags": [
        "组合",
        "持仓",
        "总览"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-brief",
      "navigation": {
        "itemOrder": 10,
        "label": "总览"
      }
    },
    {
      "id": "portfolio-activities",
      "name": "交易流水",
      "description": "录入买卖、现金、分红、费用和拆并股流水，由账本派生持仓。",
      "tags": [
        "交易",
        "流水",
        "账本"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-activities",
      "navigation": {
        "itemOrder": 20,
        "label": "流水"
      }
    },
    {
      "id": "portfolio-risk",
      "name": "组合风控",
      "description": "查看集中度、市场暴露、账户暴露与后续组合优化入口。",
      "tags": [
        "风控",
        "集中度",
        "配置"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-risk",
      "navigation": {
        "itemOrder": 30,
        "label": "风控"
      }
    },
    {
      "id": "portfolio-allocation",
      "name": "资产配置",
      "description": "按币种读取统一历史行情，比较当前权重与轻量组合优化后的目标权重。",
      "tags": [
        "资产配置",
        "组合优化",
        "PyPortfolioOpt"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-allocation",
      "navigation": {
        "itemOrder": 40,
        "label": "配置"
      }
    },
    {
      "id": "portfolio-performance",
      "name": "绩效归因",
      "description": "按币种查看账本归因，并用统一周线生成 QuantStats 风格的收益、波动、回撤和尾部风险指标。",
      "tags": [
        "绩效",
        "归因",
        "收益",
        "QuantStats"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-performance",
      "navigation": {
        "itemOrder": 50,
        "label": "绩效"
      }
    },
    {
      "id": "portfolio-settings",
      "name": "组合设置",
      "description": "管理账户、数据状态以及 Vibe-Research 旧持仓安全迁移。",
      "tags": [
        "设置",
        "账户",
        "迁移"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-settings",
      "navigation": {
        "itemOrder": 60,
        "label": "设置",
        "role": "settings"
      }
    }
  ]
}
