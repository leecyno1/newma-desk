{
  "schemaVersion": "1.0",
  "id": "market-sentiment",
  "name": "情绪分析",
  "description": "观察 A 股市场宽度、涨跌停结构、行业扩散与成交活跃度，区分事实统计与研究判断。",
  "version": "0.1.1",
  "publisher": "Newma-Desk",
  "agentWorkspace": { "type": "desk" },
  "runtime": { "type": "direct", "entry": { "type": "structured", "url": "/mods/market-daily/?workspace=sentiment" } },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": { "groupLabel": "市场", "groupOrder": 40, "itemOrder": 30, "label": "市场情绪", "directory": { "id": "market-suite", "label": "市场工具", "order": 5 }, "project": { "id": "market-surface", "name": "市场", "order": 40, "description": "行情、市场复盘、云图、技术结构、强弱、宽度与情绪。" }, "icon": "market" },
    "compatibility": { "level": 3, "bridgeProtocol": "1.0", "sdkVersion": "^0.1.0", "viewSpecVersion": "1.0" },
    "permissions": ["market.read"],
    "dataServices": ["market-data"],
    "wiki": { "contractVersion": "1.0", "subjectTypes": ["security", "etf"], "concepts": ["market-sentiment", "market-breadth"], "entrypoints": [{ "id": "sentiment", "intent": "market.sentiment", "label": "市场情绪", "contextContract": "newma.wiki.subject.v1", "defaults": {} }] },
    "actions": {
      "market.refresh": { "binding": { "type": "local" }, "execution": "request", "permission": "market.read", "inputSchema": { "type": "object", "additionalProperties": false }, "outputSchema": { "type": "object", "additionalProperties": true }, "confirmation": "none" },
      "market.symbol-search": { "binding": { "type": "data" }, "execution": "request", "permission": "market.read", "inputSchema": { "type": "object", "additionalProperties": true }, "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } }, "confirmation": "none" },
      "market.quote": { "binding": { "type": "data" }, "execution": "request", "permission": "market.read", "inputSchema": { "type": "object", "additionalProperties": true }, "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } }, "confirmation": "none" },
      "market.overview": { "binding": { "type": "data" }, "execution": "request", "permission": "market.read", "inputSchema": { "type": "object", "additionalProperties": true }, "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } }, "confirmation": "none" }
    },
    "events": { "emits": ["security.selected"], "accepts": ["security.selected"] }
  }
}
