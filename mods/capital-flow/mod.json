{
  "schemaVersion": "1.0",
  "id": "capital-flow",
  "name": "资金面",
  "description": "统一观察跨境资金、市场流动性、杠杆资金、ETF 申赎及行业与个股资金流。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/a-stock-data",
  "tags": ["资金流", "北向", "南向", "两融", "ETF", "流动性"],
  "agentWorkspace": {"type": "desk"},
  "runtime": {"type": "external", "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL", "defaultBaseUrl": "http://127.0.0.1:8911", "route": "/mod-runtime/capital-flow/"},
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "资金", "groupOrder": 8, "itemOrder": 0, "label": "资金面",
      "directory": {"id": "capital-flow-suite", "label": "资金工具", "order": 5},
      "project": {"id": "capital-flow", "name": "资金", "order": 8, "description": "跟踪跨境、杠杆、ETF、行业与个股资金流动。"},
      "icon": "market"
    },
    "compatibility": {"level": 3, "bridgeProtocol": "1.0", "sdkVersion": "^0.1.0", "viewSpecVersion": "1.0"},
    "permissions": ["market.read"],
    "dataServices": [],
    "wiki": {"contractVersion": "1.0", "subjectTypes": ["security", "etf", "fund", "industry"], "concepts": ["capital-flow", "liquidity", "northbound", "margin"], "entrypoints": [{"id": "flow", "intent": "capital.flow", "label": "资金面", "contextContract": "newma.wiki.subject.v1", "defaults": {}}]},
    "actions": {"capital-flow.refresh": {"binding": {"type": "local"}, "execution": "request", "permission": "market.read", "inputSchema": {"type": "object", "additionalProperties": false}, "outputSchema": {"type": "object", "additionalProperties": true}, "confirmation": "none"}},
    "events": {"emits": ["security.selected"], "accepts": ["security.selected"]},
    "refresh": {"mode": "schedule", "cron": "*/5 9-15 * * 1-5"}
  }
}
