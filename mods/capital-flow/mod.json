{
  "schemaVersion": "1.0",
  "id": "capital-flow",
  "name": "个股资金",
  "description": "按股票名称或代码研究主力资金、两融、龙虎榜，以及回购、股东增减持和未来解禁证据。",
  "version": "0.4.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/a-stock-data",
  "tags": ["个股资金", "两融", "龙虎榜", "回购", "增减持", "解禁"],
  "agentWorkspace": {"type": "desk"},
  "runtime": {"type": "external", "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL", "defaultBaseUrl": "http://127.0.0.1:8911", "route": "/mod-runtime/capital-flow/?view=security&mod=capital-flow"},
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "资金", "groupOrder": 30, "itemOrder": 6, "label": "个股资金",
      "directory": {"id": "capital-flow-suite", "label": "资金研究", "order": 5},
      "project": {"id": "capital-flow", "name": "资金", "order": 30, "description": "跨境资金、流动性、ETF 与个股资金、筹码及风险偏好。"},
      "icon": "market"
    },
    "compatibility": {"level": 3, "bridgeProtocol": "1.0", "sdkVersion": "^0.1.0", "viewSpecVersion": "1.0"},
    "permissions": ["market.read"],
    "dataServices": ["market-data"],
    "wiki": {"contractVersion": "1.0", "subjectTypes": ["security", "etf", "fund", "industry", "concept"], "concepts": ["capital-flow", "liquidity", "northbound", "southbound", "main-flow", "dragon-tiger", "margin", "repurchase", "holder-trade", "unlock"], "entrypoints": [{"id": "flow", "intent": "capital.flow", "label": "资金面", "contextContract": "newma.wiki.subject.v1", "defaults": {}}]},
    "actions": {"capital-flow.refresh": {"binding": {"type": "local"}, "execution": "request", "permission": "market.read", "inputSchema": {"type": "object", "additionalProperties": false}, "outputSchema": {"type": "object", "additionalProperties": true}, "confirmation": "none"}},
    "events": {"emits": ["security.selected"], "accepts": ["security.selected"]},
    "refresh": {"mode": "schedule", "cron": "*/5 9-15 * * 1-5"}
  }
}
