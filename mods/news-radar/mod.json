{
  "schemaVersion": "1.0",
  "id": "news-radar",
  "name": "新闻与舆情",
  "description": "聚合公开新闻与自选动态，按事件聚类展示热度变化、报道语气、传播范围、来源分歧和待核验线索。",
  "version": "0.3.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": ["新闻", "舆情", "资讯", "事件"],
  "agentWorkspace": {
    "type": "runtime",
    "runtimeId": "vibe-research",
    "workspaceName": "source"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/research/intel"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "全球",
      "groupOrder": 0,
      "itemOrder": 10,
      "label": "新闻与舆情",
      "directory": { "id": "global-suite", "label": "全球工具", "order": 5 },
      "project": {
        "id": "global-intelligence",
        "name": "全球",
        "order": 0,
        "description": "统一承载全球态势、新闻、冲突、灾害、事件与舆情。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["investment.read"],
    "dataServices": ["vibe-investment-native"],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["security", "etf", "fund", "topic", "industry", "concept"],
      "concepts": ["news-monitor", "sentiment"],
      "entrypoints": [
        {
          "id": "news",
          "intent": "news.monitor",
          "label": "新闻事件",
          "contextContract": "newma.wiki.subject.v1",
          "defaults": {}
        }
      ]
    },
    "actions": {
      "news.refresh": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "investment.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      }
    },
    "events": { "emits": [], "accepts": [] }
  }
}
