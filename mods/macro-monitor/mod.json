{
  "schemaVersion": "1.0",
  "id": "macro-monitor",
  "name": "宏观观察",
  "description": "汇总增长、价格与流动性的可核验证据，连接经济事件、反证、数据缺口和研究采纳意见。",
  "version": "0.1.2",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": ["宏观", "经济日历", "PMI", "通胀", "流动性", "经济预测"],
  "agentWorkspace": {
    "type": "runtime",
    "runtimeId": "vibe-research",
    "workspaceName": "source"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/research/macro-monitor"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "research",
    "navigation": {
      "groupLabel": "宏观",
      "groupOrder": 10,
      "itemOrder": 10,
      "label": "宏观观察",
      "directory": {
        "id": "macro-suite",
        "label": "宏观研究",
        "order": 5
      },
      "project": {
        "id": "fundamentals",
        "name": "宏观",
        "order": 10,
        "description": "周期叠加、经济基本面、增长通胀、金融条件与经济预测。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["market.read"],
    "dataServices": ["market-data", "crucix"],
    "actions": {
      "macro.refresh": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      },
      "crucix.snapshot": {
        "binding": {
          "type": "data",
          "service": "crucix",
          "capability": "crucix.snapshot"
        },
        "execution": "request",
        "permission": "market.read",
        "inputSchema": { "type": "object", "additionalProperties": false },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none"
      }
    },
    "events": {
      "emits": [],
      "accepts": []
    }
  }
}
