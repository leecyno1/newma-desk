{
  "schemaVersion": "1.0",
  "id": "watchlist",
  "name": "自选股",
  "description": "维护个人关注股票列表，并集中查看行情、变化和后续研究入口。",
  "version": "0.2.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": ["自选股", "行情", "列表"],
  "agentWorkspace": {
    "type": "runtime",
    "runtimeId": "vibe-research",
    "workspaceName": "source"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/research/watchlist"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "策略",
      "groupOrder": 100,
      "itemOrder": 40,
      "label": "自选与候选",
      "directory": {
        "id": "strategy-watchlist-suite",
        "label": "观察列表",
        "order": 30
      },
      "project": {
        "id": "strategy-research",
        "name": "策略",
        "order": 100,
        "description": "研究线索、条件筛选、策略验证、候选池与观察组合。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["market.read", "investment.local-write"],
    "dataServices": ["market-data"],
    "actions": {},
    "events": {
      "emits": ["security.selected"],
      "accepts": ["security.selected"]
    }
  }
}
