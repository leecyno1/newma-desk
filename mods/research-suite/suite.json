{
  "schemaVersion": "1.0",
  "id": "research-suite",
  "name": "Vibe 公司研究",
  "description": "Vibe Research 的公司研究流程，覆盖财报、逻辑、同业、估值与研究沉淀。",
  "version": "0.7.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": [
    "投研",
    "Research"
  ],
  "agentWorkspace": {
    "type": "runtime",
    "runtimeId": "vibe-research",
    "workspaceName": "source"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "research",
    "navigation": {
      "groupLabel": "公司",
      "groupOrder": 60,
      "itemOrder": 100,
      "directory": {
        "id": "research-suite",
        "label": "公司研究",
        "order": 5
      },
      "project": {
        "id": "equity-research",
        "name": "公司",
        "order": 60,
        "description": "公司基本面、财报、投资逻辑、同业、估值与研究档案。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 1,
      "bridgeProtocol": "1.0"
    },
    "permissions": [],
    "dataServices": [],
    "actions": {},
    "events": {
      "emits": [],
      "accepts": []
    }
  },
  "pages": [
    {
      "id": "earnings-workbench",
      "name": "财报研究",
      "description": "统一完成财报前预期、财报后实际、预期差、指引变化、预测修订与投资逻辑影响分析，并保留来源和截至日期。",
      "version": "0.3.0",
      "tags": [
        "财报",
        "业绩预期",
        "Beat Miss",
        "指引",
        "预测修订"
      ],
      "route": "/mod-runtime/research/earnings-workbench",
      "navigation": {
        "itemOrder": 66
      },
      "manifest": {
        "compatibility": {
          "level": 3,
          "bridgeProtocol": "1.0",
          "sdkVersion": "^0.1.0",
          "viewSpecVersion": "1.0"
        },
        "permissions": [
          "market.read",
          "storage.read",
          "storage.write",
          "investment.files"
        ],
        "dataServices": [
          "market-data"
        ],
        "storage": {
          "mode": "desk-managed",
          "namespaces": [
            {
              "id": "earnings-workbench",
              "scope": "user-workspace",
              "schemaVersion": 1,
              "quotaMb": 4,
              "maxItemKb": 256
            }
          ]
        },
        "actions": {
          "earnings.fetch-financials": {
            "binding": { "type": "data", "capability": "research.financials" },
            "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "required": ["code", "basis"], "properties": {
              "code": { "type": "string", "pattern": "^[0-9]{6}$" },
              "basis": { "enum": ["ytd", "quarter", "annual"] }
            }, "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object" } } },
            "confirmation": "none", "timeoutSeconds": 30
          },
          "earnings.refresh-evidence": {
            "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["status", "adopted", "saved"], "properties": {
              "status": { "const": "pending-review" }, "adopted": { "const": false }, "saved": { "const": false }
            } }, "confirmation": "none", "timeoutSeconds": 45
          },
          "earnings.compare": {
            "binding": { "type": "local" },
            "execution": "request",
            "permission": "storage.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "additionalProperties": true },
            "confirmation": "none",
            "timeoutSeconds": 15
          }
        },
        "events": {
          "emits": [
            "security.selected"
          ],
          "accepts": [
            "security.selected"
          ]
        }
      },
      "defaultInstall": true
    },
    {
      "id": "thesis-tracker",
      "name": "投资逻辑",
      "description": "将个股核心论点、支柱、证伪条件、催化剂、证据与阶段复盘固化为可持续更新的结构化研究档案。",
      "version": "0.1.0",
      "tags": [
        "投资逻辑",
        "证据",
        "证伪",
        "复盘"
      ],
      "route": "/mod-runtime/research/thesis-tracker",
      "navigation": {
        "itemOrder": 67
      },
      "manifest": {
        "compatibility": {
          "level": 3,
          "bridgeProtocol": "1.0",
          "sdkVersion": "^0.1.0",
          "viewSpecVersion": "1.0"
        },
        "permissions": [
          "market.read",
          "storage.read",
          "storage.write"
        ],
        "dataServices": [
          "market-data"
        ],
        "storage": {
          "mode": "desk-managed",
          "namespaces": [
            {
              "id": "thesis-tracker",
              "scope": "user-workspace",
              "schemaVersion": 1,
              "quotaMb": 4,
              "maxItemKb": 256
            }
          ]
        },
        "events": {
          "emits": [
            "security.selected"
          ],
          "accepts": [
            "security.selected"
          ]
        }
      },
      "defaultInstall": true
    },
    {
      "id": "peer-comparison",
      "name": "同业比较",
      "description": "先审计业务模式、报告期、币种和指标口径的可比性，再比较同业增长、盈利质量、资本效率、估值倍数与竞争优势。",
      "version": "0.2.0",
      "tags": [
        "同业比较",
        "可比公司",
        "估值",
        "竞争分析",
        "分位统计"
      ],
      "route": "/mod-runtime/research/peer-comparison",
      "navigation": {
        "itemOrder": 68
      },
      "manifest": {
        "actions": {
          "peer.fetch-snapshot": {
            "binding": { "type": "data", "capability": "research.equity-snapshot" },
            "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "required": ["symbol"], "properties": {
              "symbol": { "type": "string", "minLength": 1, "maxLength": 16 }
            }, "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["identity", "evidenceLedger"], "properties": {
              "identity": { "type": "object", "required": ["symbol", "market", "currency", "name"], "properties": {
                "symbol": { "type": "string" }, "market": { "type": "string" }, "currency": { "type": "string" }, "name": { "type": "string" }
              } }, "evidenceLedger": { "type": "array", "items": { "type": "object" } }
            } } } }, "confirmation": "none", "timeoutSeconds": 30
          },
          "peer.refresh": {
            "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["status", "received", "requested", "saved"], "properties": {
              "status": { "enum": ["partial", "draft-updated"] }, "received": { "type": "integer" }, "requested": { "type": "integer" }, "saved": { "const": false }
            } }, "confirmation": "none", "timeoutSeconds": 45
          },
          "peer.audit-comparability": {
            "binding": { "type": "local" }, "execution": "request", "permission": "storage.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "additionalProperties": true }, "confirmation": "none", "timeoutSeconds": 15
          }
        },
        "compatibility": {
          "level": 3,
          "bridgeProtocol": "1.0",
          "sdkVersion": "^0.1.0",
          "viewSpecVersion": "1.0"
        },
        "permissions": [
          "market.read",
          "storage.read",
          "storage.write"
        ],
        "dataServices": [
          "market-data"
        ],
        "storage": {
          "mode": "desk-managed",
          "namespaces": [
            {
              "id": "peer-comparison",
              "scope": "user-workspace",
              "schemaVersion": 1,
              "quotaMb": 4,
              "maxItemKb": 256
            }
          ]
        },
        "events": {
          "emits": [
            "security.selected"
          ],
          "accepts": [
            "security.selected"
          ]
        }
      },
      "defaultInstall": true
    },
    {
      "id": "valuation-workbench",
      "name": "预测与估值",
      "description": "用可追溯历史基期、三种经营情景、WACC、自由现金流、企业价值桥接和完整敏感性矩阵形成轻量驱动式 DCF。",
      "version": "0.3.0",
      "tags": [
        "财务预测",
        "DCF",
        "WACC",
        "估值",
        "敏感性分析"
      ],
      "route": "/mod-runtime/research/valuation-workbench",
      "navigation": {
        "itemOrder": 69
