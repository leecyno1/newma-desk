              "id": "valuation-workbench",
              "scope": "user-workspace",
              "schemaVersion": 1,
              "quotaMb": 4,
              "maxItemKb": 256
            }
          ]
        },
        "actions": {
          "valuation.fetch-price": {
            "binding": { "type": "data", "capability": "research.equity-snapshot" },
            "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "required": ["symbol"], "properties": {
              "symbol": { "type": "string", "minLength": 1, "maxLength": 16 }
            }, "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["identity", "evidenceLedger"], "properties": {
              "identity": { "type": "object", "required": ["symbol", "market", "currency"], "properties": {
                "symbol": { "type": "string" }, "market": { "type": "string" }, "currency": { "type": "string" }
              } }, "evidenceLedger": { "type": "array", "items": { "type": "object" } }
            } } } },
            "confirmation": "none", "timeoutSeconds": 30
          },
          "valuation.refresh-evidence": {
            "binding": { "type": "local" }, "execution": "request", "permission": "market.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "required": ["status", "assumptionsChanged", "saved"], "properties": {
              "status": { "const": "draft-updated" }, "assumptionsChanged": { "const": false }, "saved": { "const": false }
            } }, "confirmation": "none", "timeoutSeconds": 45
          },
          "valuation.audit-inputs": {
            "binding": { "type": "local" },
            "execution": "request",
            "permission": "storage.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "additionalProperties": true },
            "confirmation": "none",
            "timeoutSeconds": 15
          },
          "valuation.test-scenarios": {
            "binding": { "type": "local" },
            "execution": "request",
            "permission": "storage.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "additionalProperties": true },
            "confirmation": "none",
            "timeoutSeconds": 15
          },
          "valuation.explain-sensitivity": {
            "binding": { "type": "local" },
            "execution": "request",
            "permission": "storage.read",
            "inputSchema": { "type": "object", "additionalProperties": false },
            "outputSchema": { "type": "object", "additionalProperties": true },
            "confirmation": "none",
            "timeoutSeconds": 15
          }
        },
        "events": {
          "emits": [
            "security.selected"
          ],
          "accepts": [
            "security.selected"
          ]
        }
      },
      "defaultInstall": true
    },
    {
