{
  "schemaVersion": "1.0",
  "id": "portfolio-risk-suite",
  "name": "组合风险中心",
  "description": "组合风险总览、限额、集中度、敞口、回撤、流动性、压力测试、预警与处置。",
  "version": "0.2.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/ghostfolio/ghostfolio",
  "tags": [
    "风险",
    "组合",
    "Portfolio"
  ],
  "agentWorkspace": {
    "type": "desk"
  },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "风险",
      "groupOrder": 110,
      "itemOrder": 30,
      "directory": {
        "id": "portfolio-risk-suite",
        "label": "组合风险",
        "order": 10
      },
      "project": {
        "id": "risk-management",
        "name": "风险",
        "order": 110,
        "description": "风险限额、集中度、敞口、回撤、流动性、压力测试、预警与处置。"
      },
      "icon": "trading"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": [
      "portfolio.read",
      "portfolio.local-write"
    ],
    "dataServices": [
      "market-data"
    ],
    "actions": {
      "portfolio.refresh": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.import-legacy": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.local-write",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "user"
      },
      "portfolio.optimize": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      },
      "portfolio.analyze-performance": {
        "binding": {
          "type": "local"
        },
        "execution": "request",
        "permission": "portfolio.read",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "confirmation": "none"
      }
    },
    "events": {
      "emits": [
        "security.selected"
      ],
      "accepts": [
        "security.selected"
      ]
    },
    "refresh": {
      "mode": "manual"
    }
  },
  "pages": [
    {
      "id": "portfolio-risk",
      "name": "组合风控",
      "description": "管理风险限额，查看集中度、敞口、回撤、流动性和压力测试，并记录预警处置。",
      "tags": [
        "风控",
        "风险限额",
        "集中度",
        "压力测试",
        "处置记录"
      ],
      "route": "/mod-runtime/portfolio-center/?workspace=portfolio-risk",
      "navigation": {
        "itemOrder": 10,
        "label": "组合风控"
      }
    }
  ]
}
