{
  "schemaVersion": "1.0",
  "id": "policy-analysis",
  "name": "政策渠道",
  "description": "管理政策官方来源、采集状态与数据证据。",
  "version": "0.3.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/DIYgod/RSSHub",
  "tags": ["政策", "政策日历", "宏观", "监管", "RSSHub"],
  "agentWorkspace": {"type": "desk"},
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/policy-analysis/?view=sources&mod=policy-analysis"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "政策",
      "groupOrder": 20,
      "itemOrder": 3,
      "label": "政策渠道",
      "directory": {"id": "policy-suite", "label": "政策研究", "order": 5},
      "project": {
        "id": "policy-intelligence",
        "name": "政策",
        "order": 20,
        "description": "政策日历、政策流、政策量级、历史对比与影响解读。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["investment.read"],
    "dataServices": [],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["topic", "security", "etf", "fund", "industry", "concept"],
      "concepts": ["policy-monitor", "policy-calendar", "policy-lifecycle", "policy-impact"],
      "entrypoints": [{
        "id": "policy",
        "intent": "policy.monitor",
        "label": "政策分析",
        "contextContract": "newma.wiki.subject.v1",
        "defaults": {}
      }]
    },
    "actions": {
      "policy.refresh": {
        "binding": {"type": "local"},
        "execution": "request",
        "permission": "investment.read",
        "inputSchema": {"type": "object", "additionalProperties": false},
        "outputSchema": {"type": "object", "additionalProperties": true},
        "confirmation": "none"
      }
    },
    "events": {"emits": [], "accepts": []},
    "refresh": {"mode": "schedule", "cron": "0 8,12,18 * * 1-5"}
  }
}
