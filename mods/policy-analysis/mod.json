{
  "schemaVersion": "1.0",
  "id": "policy-analysis",
  "name": "政策分析",
  "description": "跟踪历史、当前与未来政策发布日程，以可解释规则评估政策量级并保留一手官方来源。",
  "version": "0.1.0",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/DIYgod/RSSHub",
  "tags": ["政策", "政策日历", "宏观", "监管", "RSSHub"],
  "agentWorkspace": {"type": "desk"},
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INVESTMENT_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:8911",
    "route": "/mod-runtime/policy-analysis/"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "event",
    "navigation": {
      "groupLabel": "政策",
      "groupOrder": 5,
      "itemOrder": 0,
      "label": "政策分析",
      "directory": {"id": "policy-suite", "label": "政策工具", "order": 5},
      "project": {
        "id": "policy-intelligence",
        "name": "政策",
        "order": 5,
        "description": "跟踪政策发布、政策量级、执行进度及市场影响。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["investment.read"],
    "dataServices": [],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["topic", "security", "etf", "fund"],
      "concepts": ["policy-monitor", "policy-calendar"],
      "entrypoints": [{
        "id": "policy",
        "intent": "policy.monitor",
        "label": "政策分析",
        "contextContract": "newma.wiki.subject.v1",
        "defaults": {}
      }]
    },
    "actions": {
      "policy.refresh": {
        "binding": {"type": "local"},
        "execution": "request",
        "permission": "investment.read",
        "inputSchema": {"type": "object", "additionalProperties": false},
        "outputSchema": {"type": "object", "additionalProperties": true},
        "confirmation": "none"
      }
    },
    "events": {"emits": [], "accepts": []},
    "refresh": {"mode": "schedule", "cron": "0 8,12,18 * * 1-5"}
  }
}
