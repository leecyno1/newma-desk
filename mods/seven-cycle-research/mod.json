{
  "schemaVersion": "1.0",
  "id": "seven-cycle-research",
  "name": "周期叠加",
  "description": "Circle 全球周期、市场曲面、资产统计与数据校准研究系统。",
  "version": "0.1.5",
  "publisher": "Newma-Desk",
  "upstream": "https://github.com/leecyno1/circle",
 "tags": ["周期", "宏观", "资产", "研究"],
  "agentWorkspace": { "type": "runtime", "runtimeId": "seven-cycle", "workspaceName": "source" },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_SEVEN_CYCLE_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:4174",
    "route": "/"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "research",
    "navigation": {
      "groupLabel": "宏观",
      "groupOrder": 10,
      "itemOrder": 0,
      "label": "周期叠加",
      "directory": { "id": "macro-suite", "label": "宏观研究", "order": 5 },
      "project": { "id": "fundamentals", "name": "宏观", "order": 10, "description": "周期叠加、经济基本面、增长通胀、金融条件与经济预测。" },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "^0.1.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["analysis.read"],
    "dataServices": [],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["topic", "industry", "concept"],
      "concepts": ["macro-cycle", "market-regime", "growth-inflation"],
      "entrypoints": [
        {
          "id": "cycle-surface",
          "intent": "macro.cycle",
          "label": "周期曲面",
          "contextContract": "newma.wiki.subject.v1",
          "defaults": {}
        }
      ]
    },
    "actions": {
      "research.configure-asset-history": {
        "binding": { "type": "local" }, "execution": "request", "permission": "analysis.read",
        "inputSchema": {
          "type": "object", "required": ["cycleId"], "additionalProperties": false,
          "properties": {
            "cycleId": { "type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
            "phase": { "type": "string", "enum": ["recovery", "expansion", "downturn", "slowdown", "contraction"], "description": "C4放缓为downturn；其余映射为slowdown。阻断周期只可传cycleId。" },
            "query": { "type": "string" }, "category": { "type": "string" },
            "confidence": { "type": "string", "enum": ["全部", "high", "medium", "low"] },
            "sortKey": { "type": "string", "enum": ["impact", "spread", "oos", "name"], "description": "impact仅C4，spread仅其他历史映射" },
            "assetId": { "type": "string", "description": "使用availableHistoryCycles中目标cycleId的assets[].id；各周期ID可不同，不可拿当前周期ID替换目标ID。必须在目标筛选内。" }
          }
        },
        "outputSchema": {
          "type": "object", "required": ["cycleId", "available", "phase", "visibleAssetCount", "selectedAsset"],
          "properties": {
            "cycleId": { "type": "string" }, "available": { "type": "boolean" },
            "phase": { "type": ["string", "null"] }, "visibleAssetCount": { "type": "integer" },
            "selectedAsset": { "type": ["object", "null"] }
          }
        },
        "confirmation": "none", "timeoutSeconds": 10
      },
      "research.configure-asset-forecast": {
        "binding": { "type": "local" }, "execution": "request", "permission": "analysis.read",
        "inputSchema": {
          "type": "object", "required": ["horizon"], "additionalProperties": false,
          "properties": {
            "horizon": { "type": "string", "enum": ["1", "3", "6"] },
            "query": { "type": "string", "default": "" },
            "majorCategory": { "type": "string", "default": "全部大类" },
            "category": { "type": "string", "default": "全部" },
            "onlyQualified": { "type": "boolean", "default": true },
            "attributionFilter": { "type": "string", "enum": ["all", "stable", "mixed", "low_impact", "unstable"], "default": "all" },
            "sortKey": { "type": "string", "enum": ["status", "probability", "return", "volatility", "attribution"], "default": "status" },
            "assetId": { "type": "string", "description": "必须在目标筛选结果内；省略则选择结果首项" }
          }
        },
        "outputSchema": {
          "type": "object", "required": ["horizonMonths", "filters", "visibleAssetCount", "selectedAsset"],
          "properties": {
            "horizonMonths": { "type": "number", "enum": [1, 3, 6] },
            "filters": { "type": "object" }, "visibleAssetCount": { "type": "integer" },
            "selectedAsset": { "type": ["object", "null"] }
          }
        },
        "confirmation": "none", "timeoutSeconds": 10
      },
      "research.configure-market": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {
          "type": "object", "required": ["view", "timeRange", "trackIds"], "additionalProperties": false,
          "properties": {
            "view": { "type": "string", "enum": ["heatmap", "3d", "2d"] },
            "timeRange": { "type": "string", "enum": ["5y", "20y", "50y", "all"] },
            "trackIds": { "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": { "type": "string" } },
            "showForecast": { "type": "boolean", "default": false },
            "comparisonDate": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$", "description": "仅热图；须在所选轨道和时间窗口中，省略则自动选择最近完整覆盖月" }
          }
        },
        "outputSchema": {
          "type": "object", "required": ["view", "timeRange", "selectedTrackIds", "forecastLayer", "comparisonDate"],
          "properties": {
            "view": { "type": "string" }, "timeRange": { "type": "string" },
            "selectedTrackIds": { "type": "array", "items": { "type": "string" } },
            "forecastLayer": { "type": "string", "enum": ["history-only", "history-and-forecast"] },
            "comparisonDate": { "type": ["string", "null"] }
          }
        },
        "confirmation": "none", "timeoutSeconds": 10
      },
      "research.select-cycle": {
        "binding": { "type": "local" },
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {
          "type": "object", "required": ["cycleId"], "additionalProperties": false,
          "properties": {
            "cycleId": { "type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7"] },
            "evidenceDetailsExpanded": { "type": "boolean", "default": false }
          }
        },
        "outputSchema": {
          "type": "object", "required": ["cycleId", "cycleName", "evidenceDetailsExpanded"],
          "properties": {
            "cycleId": { "type": "string" }, "cycleName": { "type": "string" },
            "evidenceDetailsExpanded": { "type": "boolean" }
          }
        },
        "confirmation": "none", "timeoutSeconds": 10
      }
    },
    "events": { "emits": [], "accepts": [] }
  }
}
