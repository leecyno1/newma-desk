{
  "schemaVersion": "1.0",
  "id": "instock-czsc",
  "name": "CZSC 缠论结构",
  "description": "基于官方 CZSC 的分型、笔、中枢和当前结构信号可视化，历史启发式标记与官方信号明确分层。",
  "version": "0.2.1",
  "publisher": "InStock Integration",
  "upstream": "https://github.com/myhhub/stock",
 "tags": ["CZSC", "缠论", "K线", "结构分析"],
  "agentWorkspace": { "type": "runtime", "runtimeId": "instock", "workspaceName": "source" },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_INSTOCK_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:9988",
    "route": "/mods/czsc"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "market",
    "navigation": {
      "groupLabel": "市场",
      "groupOrder": 40,
      "itemOrder": 70,
      "label": "缠论结构分析",
      "directory": {
        "id": "instock-market-analysis-suite",
        "label": "市场结构",
        "order": 10
      },
      "project": {
        "id": "market-surface",
        "name": "市场",
        "order": 40,
        "description": "行情、市场复盘、云图、技术结构、强弱、宽度与情绪。"
      },
      "icon": "market"
    },
    "compatibility": {
      "level": 2,
      "bridgeProtocol": "1.0"
    },
    "permissions": ["analysis.read"],
    "dataServices": [],
    "wiki": {
      "contractVersion": "1.0",
      "subjectTypes": ["security", "etf"],
      "concepts": ["technical-analysis", "czsc"],
      "entrypoints": [
        {
          "id": "structure",
          "intent": "technical.structure",
          "label": "CZSC 结构",
          "contextContract": "newma.wiki.subject.v1",
          "defaults": { "period": "daily", "bars": 480 }
        }
      ]
    },
    "actions": {
      "analysis.czsc": {
        "binding": {
          "type": "data",
          "capability": "analysis.czsc"
        },
        "execution": "request",
        "permission": "analysis.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "code": { "type": "string", "pattern": "^[0-9]{6}(\\.(SH|SZ|BJ))?$" },
            "period": { "enum": ["daily", "weekly", "monthly"] },
            "bars": { "enum": [120, 240, 480, 800] },
            "asOf": { "type": "string", "format": "date" },
            "refresh": { "enum": ["0", "1"] }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "required": ["ok", "data", "meta"],
          "properties": {
            "ok": { "const": true },
            "data": { "type": "object" },
            "meta": { "type": "object" }
          }
        },
        "confirmation": "none",
        "timeoutSeconds": 30
      }
    },
    "events": {
      "emits": [],
      "accepts": []
    },
    "refresh": { "mode": "manual" }
  }
}
