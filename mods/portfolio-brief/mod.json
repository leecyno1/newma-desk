{
  "schemaVersion": "1.0",
  "id": "portfolio-brief",
  "name": "我的持仓",
  "description": "集中维护持仓组合，并查看组合结构、个股信息与研究摘要。",
  "version": "0.2.0",
  "publisher": "Newma-Dock",
  "upstream": "https://github.com/simonlin1212/Vibe-Research",
  "tags": ["持仓", "组合", "投研"],
  "runtime": { "type": "external", "baseUrlEnv": "NEWMA_DOCK_INVESTMENT_WEB_URL", "defaultBaseUrl": "http://127.0.0.1:8911", "route": "/mod-runtime/research/portfolio" },
  "manifest": {
    "category": "market",
    "navigation": { "groupLabel": "市场", "groupOrder": 10, "itemOrder": 30, "icon": "market" },
    "permissions": ["investment.read", "investment.local-write"],
    "dataServices": ["market-data"],
    "events": {
      "emits": ["security.selected"],
      "accepts": ["security.selected"]
    }
  }
}
