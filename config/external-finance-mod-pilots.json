{
  "schemaVersion": "1.0",
  "reservedPorts": [5888, 5891, 8001, 8011, 8911, 8912, 9988],
  "pilots": [
    {
      "id": "daily-stock-analysis",
      "label": "Daily Stock Analysis",
      "upstream": "https://github.com/ZhuLinsen/daily_stock_analysis",
      "license": "MIT",
      "mode": "analysis-only",
      "audit": {
        "revision": "905c339d80ad2daa6fd2bab3bb10267b23c7ac1c",
        "tag": "v3.28.0",
        "reviewedAt": "2026-07-27",
        "dependencyAudit": "blocked-unpinned-requirements"
      },
      "activation": {
        "defaultEnabled": false,
        "env": "NEWMA_DESK_DAILY_STOCK_ANALYSIS_PILOT_ENABLED"
      },
      "workspace": {
        "env": "NEWMA_DESK_DAILY_STOCK_ANALYSIS_WORKSPACE",
        "candidates": [
          "daily_stock_analysis",
          "finance-pilots/daily_stock_analysis"
        ]
      },
      "runtime": {
        "origin": "http://127.0.0.1:8921",
        "healthPath": "/api/v1/health",
        "upstreamDefaultPorts": [8000]
      },
      "isolation": {
        "deskDataOnly": true,
        "directInternet": false,
        "dockOrigins": ["http://127.0.0.1:8911"],
        "dataDir": ".runtime/pilots/daily-stock-analysis",
        "environmentAllowlist": [
          "TZ",
          "LOG_LEVEL",
          "WEBUI_HOST",
          "WEBUI_PORT",
          "DATABASE_URL",
          "REPORT_LANGUAGE"
        ],
        "environmentDenyPatterns": [
          "*_API_KEY",
          "*_TOKEN",
          "*_SECRET",
          "*_PASSWORD",
          "FUTU_*",
          "LONGBRIDGE_*",
          "AGENT_*",
          "GENERATION_*",
          "*WEBHOOK*",
          "*SMTP*"
        ]
      },
      "capabilities": {
        "allow": [
          "research.analysis.run",
          "research.analysis-context.read",
          "research.report-history.read",
          "research.task-progress.read",
          "research.data-quality.read",
          "research.schedule.plan"
        ],
        "deny": [
          "trade.execute",
          "trade.order.submit",
          "portfolio.import-broker",
          "backtest.execute",
          "agent.invoke",
          "model.invoke",
          "notification.send",
          "credentials.read"
        ]
      },
      "extract": {
        "include": [
          "analysis-context",
          "report-history",
          "task-progress",
          "data-source-fallback",
          "data-quality-diagnostics",
          "schedule-planning"
        ],
        "exclude": [
          "buy-sell-signals",
          "investment-scoring",
          "built-in-agent",
          "portfolio-accounting",
          "notifications",
          "backtest-ui",
          "futu-import"
        ]
      },
      "acceptanceGates": [
        "dependency-audit",
        "static-secret-scan",
        "capability-contract",
        "no-port-conflict",
        "no-broker-import",
        "desk-agent-context",
        "responsive-embed"
      ]
    },
