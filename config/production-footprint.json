{
  "schemaVersion": "1.0",
  "artifacts": [
    {
      "id": "desk-shell",
      "path": "apps/shell/dist",
      "required": true,
      "maxTotalBytes": 921600,
      "maxFileBytes": 430080
    },
    {
      "id": "portfolio-runtime",
      "path": "modules/portfolio-center/dist",
      "required": true,
      "maxTotalBytes": 430080,
      "maxFileBytes": 358400
    },
    {
      "id": "research-suite",
      "path": "mod-projects/vibe-research/frontend/dist",
      "required": false,
      "maxTotalBytes": 1048576,
      "maxFileBytes": 262144,
      "forbiddenText": [
        "订阅接入",
        "Claude Code",
        "openrouter",
        "api.deepseek"
      ]
    },
    {
      "id": "trading-suite",
      "path": "mod-projects/vibe-trading/frontend/dist",
      "required": false,
      "maxTotalBytes": 1900000,
      "maxFileBytes": 720000
    }
  ],
  "dockerContext": {
    "ignoreFile": ".dockerignore",
    "requiredPatterns": [
      ".git",
      ".worktrees",
      "legacy-workspace",
      "**/node_modules",
      "**/.venv",
      "**/.pytest_cache",
      "**/.cache",
