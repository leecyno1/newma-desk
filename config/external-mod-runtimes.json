{
  "schemaVersion": "2.0",
  "roots": [
    {
      "id": "projects",
      "env": "NEWMA_DESK_PROJECTS_ROOT",
      "fallback": { "type": "repo-relative", "path": ".." }
    },
    {
      "id": "desktop-projects",
      "env": "NEWMA_DESK_DESKTOP_PROJECTS_ROOT",
      "fallback": { "type": "home-relative", "path": "Desktop/Projects" }
    }
  ],
  "profiles": {
    "core": {
      "preCore": ["world-intel"],
      "optional": []
    },
    "local": {
      "preCore": ["world-intel", "crucix", "policy-rsshub"],
      "optional": ["instock", "fund-analysis", "orchestra"]
    },
    "all": {
      "preCore": ["world-intel", "crucix", "policy-rsshub"],
      "optional": [
        "openchatcut",
        "instock",
        "fund-analysis",
        "orchestra",
        "seven-cycle",
        "deepsee"
      ]
    }
  },
  "runtimes": [
    {
      "id": "vibe-research",
      "label": "Vibe Research",
      "adapter": "integrated",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_INVESTMENT_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/vibe-research" },
            { "root": "repo", "path": "mod-projects/vibe-research" },
            { "root": "projects", "path": "vibe-research" }
          ]
        }
      },
      "endpoints": {}
    },
    {
      "id": "vibe-trading",
      "label": "Vibe Trading",
      "adapter": "integrated",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_TRADING_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/vibe-trading" },
            { "root": "repo", "path": "mod-projects/vibe-trading" },
            { "root": "projects", "path": "vibe-trading" }
          ]
        }
      },
      "endpoints": {}
    },
    {
      "id": "creator-studio",
      "label": "Newma Creator Studio",
      "adapter": "integrated",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_CREATOR_STUDIO_WORKSPACE",
          "candidates": [
            { "root": "projects", "path": "公众号文章" },
            { "root": "repo", "path": "bundled-runtimes/creator-studio" },
            { "root": "repo", "path": "mod-projects/creator-studio" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_CREATOR_STUDIO_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:8911",
          "healthPath": "/api/creator-studio/system"
        }
      }
    },
    {
      "id": "policy-rsshub",
      "label": "Policy RSSHub Collector",
      "adapter": "rsshub-policy",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_POLICY_RSSHUB_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/rsshub-policy" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_POLICY_RSSHUB_URL",
          "defaultOrigin": "http://127.0.0.1:1200",
          "healthPath": "/healthz"
        }
      },
      "services": [
        {
          "id": "policy-rsshub",
          "label": "Policy RSSHub Collector",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{workspace}}/node_modules/.bin/tsx",
            "args": ["lib/index.ts"],
            "requiredPaths": ["node_modules/.bin/tsx", "assets/build/routes.js"],
            "stdio": "ignore",
            "env": {
              "NODE_ENV": "production",
              "PORT": "{{endpoint.port}}",
              "LOGGER_LEVEL": "warn",
              "NO_LOGFILES": "true"
            }
          },
          "readiness": { "mode": "text", "expectedText": "ok" }
        }
      ]
    },
    {
      "id": "openchatcut",
      "label": "OpenChatCut Collaborative Editor",
      "adapter": "external-editor",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_OPENCHATCUT_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/openchatcut" },
            { "root": "projects", "path": "公众号文章/vendor/reserved/video/openchatcut" },
            { "root": "projects", "path": "OpenChatCut" },
            { "root": "projects", "path": "openchatcut" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_OPENCHATCUT_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:5199",
          "healthPath": "/"
        },
        "mcp": {
          "env": "NEWMA_DESK_OPENCHATCUT_MCP_ORIGIN",
          "defaultOrigin": "http://127.0.0.1:5199",
          "interfacePath": "/api/external-mcp/mcp",
          "healthPath": "/"
        }
      },
      "services": [
        {
          "id": "openchatcut-editor",
          "label": "OpenChatCut Collaborative Editor",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": { "adapter": "openchatcut" },
          "readiness": { "mode": "html", "timeoutMs": 15000 }
        }
      ]
    },
    {
      "id": "world-intel",
      "label": "World Intelligence MCP",
      "adapter": "world-intel",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_WORLD_INTEL_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/world-intel-mcp" },
            { "root": "repo", "path": "mod-projects/world-intel-mcp" },
            { "root": "projects", "path": "world-intel-mcp" }
          ]
        }
      },
      "endpoints": {
        "api": {
          "env": "NEWMA_DESK_WORLD_INTEL_URL",
          "defaultOrigin": "http://127.0.0.1:8501",
          "healthPath": "/api/health"
        }
      },
      "services": [
        {
          "id": "world-intel-mcp",
          "label": "World Intelligence MCP",
          "workspace": "source",
          "endpoint": "api",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{workspace}}/.venv/bin/python",
            "args": [
              "-m",
              "world_intel_mcp.dashboard.app",
              "--host",
              "127.0.0.1",
              "--port",
              "{{endpoint.port}}"
            ],
            "prepare": "world-intel",
            "env": {
              "PYTHONUNBUFFERED": "1",
              "WORLD_INTEL_DASHBOARD_HOST": "127.0.0.1",
              "WORLD_INTEL_DASHBOARD_PORT": "{{endpoint.port}}"
            }
          },
          "readiness": { "mode": "json", "expectedService": "world-intel-mcp" }
        }
      ]
    },
    {
      "id": "crucix",
      "label": "Crucix Intelligence Engine",
      "adapter": "crucix",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_CRUCIX_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/crucix" },
            { "root": "repo", "path": "mod-projects/crucix" },
            { "root": "projects", "path": "Crucix" },
            { "root": "projects", "path": "crucix" }
          ]
        }
      },
      "endpoints": {
        "api": {
          "env": "NEWMA_DESK_CRUCIX_URL",
          "defaultOrigin": "http://127.0.0.1:3117",
          "healthPath": "/api/health"
        }
      },
      "services": [
        {
          "id": "crucix",
          "label": "Crucix 全球情报引擎",
          "workspace": "source",
          "endpoint": "api",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "node",
            "args": ["server.mjs"],
            "env": {
              "HOST": "127.0.0.1",
              "PORT": "{{endpoint.port}}",
              "PUBLIC_URL": "{{endpoint.origin}}",
              "AUTO_OPEN_DASHBOARD": "false"
            }
          },
          "readiness": { "mode": "json", "timeoutMs": 5000 }
        }
      ]
    },
    {
      "id": "deepsee",
      "label": "Deepsee",
      "adapter": "deepsee",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_DEEPSEE_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/deepsee" },
            { "root": "projects", "path": "0913" },
            { "root": "projects", "path": "deepsee" },
            { "root": "repo", "path": "mod-projects/deepsee" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_DEEPSEE_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:8001",
          "healthPath": "/api/health"
        }
      },
      "services": [
        {
          "id": "deepsee",
          "label": "Deepsee",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{python}}",
            "args": [
              "-m",
              "uvicorn",
              "app.main:app",
              "--host",
              "127.0.0.1",
              "--port",
              "{{endpoint.port}}"
            ],
            "env": {
              "PYTHONUNBUFFERED": "1",
              "HOST": "127.0.0.1",
              "PORT": "{{endpoint.port}}"
            }
          },
          "readiness": { "mode": "json", "expectedService": "deepsee" }
        }
      ]
    },
    {
      "id": "seven-cycle",
      "label": "Seven Cycle Research",
      "adapter": "seven-cycle",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_SEVEN_CYCLE_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/seven-cycle" },
            { "root": "projects", "path": "1周期模块" },
            { "root": "projects", "path": "seven-cycle" },
            { "root": "repo", "path": "mod-projects/seven-cycle" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_SEVEN_CYCLE_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:4174",
          "healthPath": "/healthz"
        }
      },
      "services": [
        {
          "id": "seven-cycle-research",
          "label": "Seven Cycle Research",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": { "adapter": "seven-cycle", "prepare": "seven-cycle" },
          "readiness": {
            "mode": "json",
            "expectedService": "seven-cycle-platform",
            "timeoutMs": 5000,
            "timeoutEnv": "NEWMA_DESK_SEVEN_CYCLE_HEALTH_TIMEOUT_MS",
            "degradedStatuses": [409]
          }
        }
      ]
    },
    {
      "id": "instock",
      "label": "InStock Analysis",
      "adapter": "instock",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_INSTOCK_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/instock-analysis" },
            { "root": "projects", "path": "stock-czsc-integration" },
            { "root": "projects", "path": "instock-analysis" },
            { "root": "repo", "path": "mod-projects/instock-analysis" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_INSTOCK_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:9988",
          "healthPath": "/api/v1/health"
        }
      },
      "services": [
        {
          "id": "instock-analysis",
          "label": "InStock Analysis",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{python}}",
            "args": [
              "-I", "-m", "instock.runtime", "--mode", "desk",
              "--host", "127.0.0.1", "--port", "{{endpoint.port}}",
              "--state-dir", "{{workspace}}/instock/cache",
              "--log-dir", "{{workspace}}/instock/log"
            ],
            "env": {
              "PYTHONUNBUFFERED": "1",
              "INSTOCK_SKIP_DB": "1",
              "INSTOCK_DESK_SCOPE_URL": "http://127.0.0.1:8911/api/mods/runtime/instock-scope",
              "INSTOCK_MARKET_SERVICES_URL": "http://127.0.0.1:8911",
              "INSTOCK_MARKET_DATA_PROVIDER": "vibedesk",
              "NEWMA_DESK_DATA_URL": "http://127.0.0.1:8911/api/research",
              "NEWMA_DESK_PARENT_ORIGIN": "http://127.0.0.1:5888",
              "NEWMA_DOCK_DATA_URL": "http://127.0.0.1:8911/api/research",
              "NEWMA_DOCK_PARENT_ORIGIN": "http://127.0.0.1:5888",
              "VIBEDESK_DATA_URL": "http://127.0.0.1:8911/api/research",
              "VIBEDESK_PARENT_ORIGIN": "http://127.0.0.1:5888",
              "INSTOCK_EMBED_ORIGINS": "http://127.0.0.1:5888",
              "INSTOCK_CORS_ORIGINS": "http://127.0.0.1:5888",
              "INSTOCK_WEB_HOST": "127.0.0.1",
              "INSTOCK_WEB_PORT": "{{endpoint.port}}"
            }
          },
          "readiness": {
            "mode": "json",
            "expectedService": "instock-analysis",
            "timeoutMs": 5000
          }
        }
      ]
    },
    {
      "id": "fund-analysis",
      "label": "Fund Analysis",
      "adapter": "fund-analysis",
      "workspaces": {
        "source": {
          "env": "NEWMA_DESK_FUND_ANALYSIS_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/fund-analysis" },
            { "root": "projects", "path": "基金筛选/fund-analysis" },
            { "root": "repo", "path": "mod-projects/fund-analysis" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_FUND_RESEARCH_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:3035",
          "healthPath": "/api/newma-desk/health"
        },
        "api": {
          "env": "NEWMA_DESK_FUND_ANALYSIS_API_URL",
          "defaultOrigin": "http://127.0.0.1:8035",
          "healthPath": "/api/health"
        }
      },
      "services": [
        {
          "id": "fund-analysis-api",
          "label": "Fund Analysis API",
          "workspace": "source",
          "endpoint": "api",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "bash",
            "args": ["backend/scripts/start_backend.sh"],
            "env": {
              "PYTHONUNBUFFERED": "1",
              "FUND_DATABASE_INIT_MODE": "check",
              "HOST": "127.0.0.1",
              "PORT": "{{endpoint.port}}"
            }
          },
          "readiness": { "mode": "json", "expectedService": "fund-analysis-api", "startupTimeoutMs": 120000 }
        },
        {
          "id": "fund-analysis-web",
          "label": "Fund Analysis Web",
          "workspace": "source",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{workspace}}/node_modules/.bin/next",
            "args": [
              "dev",
              "--hostname",
              "127.0.0.1",
              "--port",
              "{{endpoint.port}}"
            ],
            "env": {
              "BACKEND_API_URL": "{{endpoints.api.origin}}",
              "NEXT_PUBLIC_BACKEND_API_URL": "{{endpoints.api.origin}}"
            }
          },
          "readiness": {
            "mode": "json",
            "expectedService": "fund-analysis-data",
            "timeoutMs": 5000
          }
        }
      ]
    },
    {
      "id": "orchestra",
      "label": "Orchestra",
      "adapter": "orchestra",
      "workspaces": {
        "frontend": {
          "env": "NEWMA_DESK_ORCHESTRA_FRONTEND_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/orchestra-prisma" },
            { "root": "projects", "path": "orchestra-prisma" },
            { "root": "projects", "path": "投研日常/orchestra-prisma" },
            { "root": "desktop-projects", "path": "投研日常/orchestra-prisma" }
          ]
        },
        "backend": {
          "env": "NEWMA_DESK_ORCHESTRA_BACKEND_WORKSPACE",
          "candidates": [
            { "root": "repo", "path": "bundled-runtimes/orchestra-agentscope" },
            { "root": "projects", "path": "orchestra-agentscope" },
            { "root": "projects", "path": "投研日常/orchestra-agentscope" },
            { "root": "desktop-projects", "path": "投研日常/orchestra-agentscope" }
          ]
        }
      },
      "endpoints": {
        "web": {
          "env": "NEWMA_DESK_ORCHESTRA_WEB_URL",
          "defaultOrigin": "http://127.0.0.1:3001",
          "healthPath": "/"
        },
        "api": {
          "env": "NEWMA_DESK_ORCHESTRA_API_URL",
          "defaultOrigin": "http://127.0.0.1:8011",
          "healthPath": "/healthz"
        }
      },
      "services": [
        {
          "id": "orchestra-api",
          "label": "Orchestra API",
          "workspace": "backend",
          "endpoint": "api",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "{{python}}",
            "args": ["-m", "orchestra_app.main"],
            "env": {
              "PYTHONUNBUFFERED": "1",
              "ORCHESTRA_API_HOST": "127.0.0.1",
              "ORCHESTRA_API_PORT": "{{endpoint.port}}",
              "ORCHESTRA_PROJECT_ROOT": "{{workspace}}"
            }
          },
          "readiness": { "mode": "json", "expectedService": "orchestra" }
        },
        {
          "id": "orchestra-web",
          "label": "Orchestra Web",
          "workspace": "frontend",
          "endpoint": "web",
          "criticality": { "local": "optional", "remote": "external" },
          "launch": {
            "command": "npm",
            "args": [
              "run",
              "dev",
              "--",
              "--host",
              "127.0.0.1",
              "--port",
              "{{endpoint.port}}",
              "--strictPort"
            ],
            "env": {
              "ORCHESTRA_API_TARGET": "{{endpoints.api.origin}}",
              "VITE_NEWMA_DESK_PARENT_ORIGIN": "http://127.0.0.1:5888",
              "VITE_NEWMA_DOCK_PARENT_ORIGIN": "http://127.0.0.1:5888"
            }
          },
          "readiness": { "mode": "html" }
        }
      ]
    }
  ]
}
