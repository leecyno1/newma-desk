# Copy this file to deploy/server/.env.server, replace every example value,
# then run from the repository root with explicit Compose interpolation:
# docker compose --env-file deploy/server/.env.server -f deploy/server/docker-compose.yml up -d

# Production uses dedicated HTTPS Origins on the same server. Desk and Mod/API
# must remain cross-origin from each other and from Newma WebUI. Raw ports below
# are acceptable only for an isolated local-development profile.
PUBLIC_DESK_ORIGIN=https://desk.example.com
PUBLIC_MOD_ORIGIN=https://market.example.com
PUBLIC_API_ORIGIN=https://mods.example.com

NEWMA_DESK_ALLOWED_ORIGINS=https://desk.example.com,https://mods.example.com,https://market.example.com
NEWMA_DESK_INVESTMENT_WEB_URL=https://mods.example.com
NEWMA_DESK_TRADING_WEB_URL=https://mods.example.com
NEWMA_DESK_DEEPSEE_WEB_URL=http://SERVER_IP:8001
NEWMA_DESK_SEVEN_CYCLE_WEB_URL=http://SERVER_IP:4174
NEWMA_DESK_INSTOCK_WEB_URL=http://SERVER_IP:9988
NEWMA_DESK_ORCHESTRA_WEB_URL=http://SERVER_IP:3001
NEWMA_DESK_ORCHESTRA_API_URL=http://SERVER_IP:8011
NEWMA_DESK_RESEARCH_BASE_URL=http://api:8911/api/research

# Desk API -> Newma/Hermes WebUI. Choose the actual internal listener for the
# target server: standard managed nodes normally use 8788, while c10375 uses
# 8787. When WebUI runs on the Docker host, host.docker.internal is provided by
# docker-compose.yml; the listener or a private reverse proxy must be reachable
# from the Docker bridge. Never put this host-only URL into browser manifests.
NEWMA_DESK_HERMES_WEBUI_BASE_URL=http://host.docker.internal:8788
NEWMA_DESK_HERMES_WEBUI_COOKIE=
NEWMA_DESK_HERMES_WEBUI_CSRF_TOKEN=
NEWMA_DESK_HERMES_WEBUI_WORKSPACE=

# Per-container guardrails. The API limit leaves room for pandas factor jobs;
# Desk, Market and Gateway are static nginx runtimes.
NEWMA_DESK_API_MEMORY_LIMIT=768m
NEWMA_DESK_STATIC_MEMORY_LIMIT=96m

NEWMA_DESK_OPENAI_API_KEY=
NEWMA_DESK_ANTHROPIC_API_KEY=
TUSHARE_TOKEN=
NEWMA_DESK_MOD_SESSION_SECRET=replace-with-a-long-random-secret
NEWMA_DESK_TRADE_CONFIRMATION_SECRET=replace-with-a-long-random-secret
