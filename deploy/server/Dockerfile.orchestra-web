FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_PROXY_MODE=local
ARG VITE_VIBEDESK_PARENT_ORIGIN
ENV VITE_API_PROXY_MODE=${VITE_API_PROXY_MODE}
ENV VITE_VIBEDESK_PARENT_ORIGIN=${VITE_VIBEDESK_PARENT_ORIGIN}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN test -n "$VITE_VIBEDESK_PARENT_ORIGIN" && npm run build

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=80
ENV PRISMA_STATIC_DIR=/app/dist

COPY --from=build /app/dist /app/dist

EXPOSE 80

CMD ["node", "/app/server.mjs"]
