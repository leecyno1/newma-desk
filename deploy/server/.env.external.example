# Copy this file to deploy/server/.env.external, replace every example value,
# then run from the repository root with explicit Compose interpolation:
# docker compose --env-file deploy/server/.env.external -f deploy/server/docker-compose.external.yml up -d

PUBLIC_DESK_ORIGIN=http://SERVER_IP:5888
PUBLIC_API_ORIGIN=http://SERVER_IP:8911

ORCHESTRA_POSTGRES_PASSWORD=replace-with-a-random-password
ORCHESTRA_SECRET_MASTER_KEY=replace-with-a-fernet-key
ORCHESTRA_RUN_WORKERS=1
ORCHESTRA_MAX_CONCURRENCY=1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
TUSHARE_TOKEN=
TAVILY_API_KEY=
