{
  "id": "market-data",
  "name": "Newma-Desk 市场数据",
  "description": "统一提供 A 股、港股、美股行情与研究数据。",
  "priority": 10,
  "baseUrl": "http://127.0.0.1:8911/api/research",
  "healthPath": "/health",
  "transport": "rest",
  "capabilities": {
    "market.global-indices": {
      "method": "GET",
      "path": "/global/indices",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.indices": {
      "method": "GET",
      "path": "/indices",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.overview": {
      "method": "GET",
      "path": "/market/overview",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.turnover-top": {
      "method": "GET",
      "path": "/market/turnover-top",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.symbol-search": {
      "method": "GET",
      "path": "/api/market-terminal/search",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 48 },
          "market": { "enum": ["ALL", "CN", "HK", "US"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.security-master": {
      "method": "GET",
      "path": "/api/market-terminal/security-master",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.security-master-refresh": {
      "method": "POST",
      "path": "/api/market-terminal/security-master/refresh",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.write"
    },
    "market.quotes": {
      "method": "GET",
      "path": "/api/market-terminal/quotes",
      "inputSchema": {
        "type": "object",
        "required": ["symbols"],
        "properties": { "symbols": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.quote": {
      "method": "GET",
      "path": "/api/market-terminal/quote",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.scan": {
      "method": "GET",
      "path": "/api/market-terminal/scan",
      "inputSchema": {
        "type": "object",
        "required": ["market"],
        "properties": {
          "market": { "enum": ["CN", "HK", "US"] },
          "sort": { "enum": ["changePct", "amount", "turnoverPct", "volumeRatio", "marketCap", "pe", "pb"] },
          "order": { "enum": ["asc", "desc"] },
          "limit": { "type": "integer", "minimum": 20, "maximum": 200 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.ohlcv": {
      "method": "GET",
      "path": "/api/market-terminal/ohlcv",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market", "timeframe"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "timeframe": { "enum": ["1m", "5m", "15m", "30m", "60m", "1d", "1w", "1M"] },
          "limit": { "type": "integer", "minimum": 40, "maximum": 800 },
          "adjust": { "enum": ["none", "qfq", "hfq"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.intraday": {
      "method": "GET",
      "path": "/api/market-terminal/ohlcv",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market", "timeframe"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "timeframe": { "enum": ["1m", "5m", "15m", "30m", "60m"] },
          "limit": { "type": "integer", "minimum": 40, "maximum": 800 },
          "adjust": { "enum": ["none", "qfq", "hfq"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.equity-snapshot": {
      "method": "GET",
      "path": "/equity-research/snapshot",
      "inputSchema": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.equity-comparison": {
      "method": "GET",
      "path": "/equity-research/comparison",
      "inputSchema": {
        "type": "object",
        "required": ["symbols"],
        "properties": {
          "symbols": { "type": "string", "minLength": 3, "maxLength": 160 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.catalysts": {
      "method": "GET",
      "path": "/catalysts",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbols": { "type": "string", "maxLength": 512 },
          "days": { "type": "integer", "minimum": 14, "maximum": 1095 },
          "include_cycles": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.macro-monitor": {
      "method": "GET",
      "path": "/macro-monitor",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.emotion": {
      "method": "GET",
      "path": "/market/emotion",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "capital.fund-flow": {
      "method": "GET",
      "path": "/fund-flow",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "capital.margin": {
      "method": "GET",
      "path": "/margin",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "capital.dragon-tiger": {
      "method": "GET",
      "path": "/dragon-tiger",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.announcements": {
      "method": "GET",
      "path": "/announcements",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "assetType": { "enum": ["stock", "etf", "fund"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.reports": {
      "method": "GET",
      "path": "/reports",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "pages": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.news": {
      "method": "GET",
      "path": "/news",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    }
  },
  "timeoutSeconds": 15,
  "allowedHosts": ["127.0.0.1"]
}
