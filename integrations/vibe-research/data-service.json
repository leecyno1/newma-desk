{
  "id": "market-data",
  "name": "Newma-Desk 市场数据",
  "description": "统一提供 A 股、港股、美股行情与研究数据。",
  "priority": 10,
  "baseUrl": "http://127.0.0.1:8911/api/research",
  "healthPath": "/health",
  "transport": "rest",
  "capabilities": {
    "market.health": {
      "method": "GET",
      "path": "/health",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["ok", "service"],
        "properties": { "ok": { "type": "boolean" }, "service": { "type": "string" } }
      },
      "permission": "market.read"
    },
    "market.global-indices": {
      "method": "GET",
      "path": "/global/indices",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.indices": {
      "method": "GET",
      "path": "/indices",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.overview": {
      "method": "GET",
      "path": "/market/overview",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.turnover-top": {
      "method": "GET",
      "path": "/market/turnover-top",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.symbol-search": {
      "method": "GET",
      "path": "/market-terminal/search",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 48 },
          "market": { "enum": ["ALL", "CN", "HK", "US"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.security-master": {
      "method": "GET",
      "path": "/market-terminal/security-master",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.security-master-refresh": {
      "method": "POST",
      "path": "/market-terminal/security-master/refresh",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.write"
    },
    "market.quotes": {
      "method": "GET",
      "path": "/market-terminal/quotes",
      "inputSchema": {
        "type": "object",
        "required": ["symbols"],
        "properties": { "symbols": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.quote": {
      "method": "GET",
      "path": "/market-terminal/quote",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.scan": {
      "method": "GET",
      "path": "/market-terminal/scan",
      "inputSchema": {
        "type": "object",
        "required": ["market"],
        "properties": {
          "market": { "enum": ["CN", "HK", "US"] },
          "sort": { "enum": ["changePct", "amount", "turnoverPct", "volumeRatio", "marketCap", "pe", "pb"] },
          "order": { "enum": ["asc", "desc"] },
          "limit": { "type": "integer", "minimum": 20, "maximum": 200 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.ohlcv": {
      "method": "GET",
      "path": "/market-terminal/ohlcv",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market", "timeframe"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "timeframe": { "enum": ["1m", "5m", "15m", "30m", "60m", "1d", "1w", "1M"] },
          "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "仅CN日线；在当前来源窗口中筛选截止日，非任意历史回放。" },
          "limit": { "type": "integer", "minimum": 40, "maximum": 800 },
          "adjust": { "enum": ["none", "qfq", "hfq"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.intraday": {
      "method": "GET",
      "path": "/market-terminal/ohlcv",
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "market", "timeframe"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 24 },
          "market": { "enum": ["CN", "HK", "US"] },
          "timeframe": { "enum": ["1m", "5m", "15m", "30m", "60m"] },
          "limit": { "type": "integer", "minimum": 40, "maximum": 800 },
          "adjust": { "enum": ["none", "qfq", "hfq"] },
          "assetType": { "enum": ["stock", "etf", "fund", "index"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.financials": {
      "method": "GET", "path": "/financials",
      "inputSchema": { "type": "object", "required": ["code", "basis"], "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{6}$" }, "basis": { "enum": ["ytd", "quarter", "annual"] }
      }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": {
        "type": "object", "required": ["basis", "period"], "properties": {
          "basis": { "enum": ["ytd", "quarter", "annual"] }, "period": { "type": ["string", "number", "null"] },
          "revenue": { "type": ["string", "null"] }, "revenue_yoy": { "type": ["string", "null"] },
          "net_profit": { "type": ["string", "null"] }, "net_profit_yoy": { "type": ["string", "null"] },
          "eps": { "type": ["string", "null"] }, "bvps": { "type": ["string", "null"] },
          "roe": { "type": ["string", "null"] }, "gross_margin": { "type": ["string", "null"] },
          "net_margin": { "type": ["string", "null"] }, "op_cf_ps": { "type": ["string", "null"] }
        }
      } } },
      "permission": "market.read"
    },
    "research.equity-snapshot": {
      "method": "GET",
      "path": "/equity-research/snapshot",
      "timeoutSeconds": 45,
      "inputSchema": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "maxLength": 16 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.statement-announcements": {
      "method": "GET", "path": "/equity-research/statement-announcements",
      "inputSchema": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } }, "additionalProperties": false },
      "outputSchema": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["symbol", "source", "items", "begin", "end", "hasMore", "boundary"], "properties": { "source": { "const": "cninfo" }, "items": { "type": "array" } } } } },
      "permission": "market.read"
    },
    "research.statement-evidence": {
      "method": "GET",
      "path": "/equity-research/statement-evidence",
      "inputSchema": {
        "type": "object", "required": ["code", "announcementId"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "announcementId": { "type": "string", "pattern": "^(AN[0-9]{10,30}|[0-9]{10,20})$" },
          "source": { "type": "string", "enum": ["eastmoney", "cninfo"], "default": "eastmoney" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object", "required": ["data"],
        "properties": { "data": { "type": "object", "required": ["symbol", "announcementId", "announcementSource", "periodEnd", "facts", "pdfUrl", "contentOrigin"],
          "properties": { "facts": { "type": "array" }, "announcementSource": { "enum": ["eastmoney", "cninfo"] }, "contentOrigin": { "const": "pdf-text" } } } }
      },
      "permission": "market.read"
    },
    "research.equity-comparison": {
      "method": "GET",
      "path": "/equity-research/comparison",
      "timeoutSeconds": 55,
      "inputSchema": {
        "type": "object",
        "required": ["symbols"],
        "properties": {
          "symbols": { "type": "string", "minLength": 3, "maxLength": 160 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.catalysts": {
      "method": "GET",
      "path": "/catalysts",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbols": { "type": "string", "maxLength": 512 },
          "days": { "type": "integer", "minimum": 14, "maximum": 1095 },
          "include_cycles": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "research.macro-monitor": {
      "method": "GET",
      "path": "/macro-monitor",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.emotion": {
      "method": "GET",
      "path": "/market/emotion",
      "inputSchema": { "type": "object", "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "capital.fund-flow": {
      "method": "GET",
      "path": "/fund-flow",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "capital.margin": {
      "method": "GET",
      "path": "/margin",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "capital.dragon-tiger": {
      "method": "GET",
      "path": "/dragon-tiger",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "object" } }
      },
      "permission": "market.read"
    },
    "market.announcements": {
      "method": "GET",
      "path": "/announcements",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "assetType": { "enum": ["stock", "etf", "fund"] }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.reports": {
      "method": "GET",
      "path": "/reports",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "pages": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    },
    "market.news": {
      "method": "GET",
      "path": "/news",
      "inputSchema": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[0-9]{6}$" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "type": "array" } }
      },
      "permission": "market.read"
    }
  },
  "timeoutSeconds": 15,
  "allowedHosts": ["127.0.0.1"]
}
